<%# navbar_public.ejs Public-facing navbar — used on: landing, login, signup,
and any other public page. Self-contained: includes its own
<style>
  block so fonts and layout are consistent
  on every page regardless of whether landing.css or auth.css is loaded.
%>
<style>
  /* ── navbar_public: tokens (scoped to --nav-* to avoid collisions) ── */
  :root {
    --nav-font-clash: "Clash Display", "Helvetica Neue", Arial, sans-serif;
    --nav-font-caveat: "Caveat", "Comic Sans MS", cursive;
    --nav-ink: #1c1814;
    --nav-ink-2: #3a3228;
    --nav-ink-3: #7a6e62;
    --nav-cream: #faf7f2;
    --nav-cream-3: #e4dbd0;
    --nav-teal: #3d8c80;
    --nav-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --nav-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --nav-page-h: clamp(1.5rem, 5vw, 4rem);
  }

  /* ── layout ── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem var(--nav-page-h);
    transition:
      background 0.4s,
      box-shadow 0.4s,
      padding 0.3s;
  }
  .nav.scrolled {
    background: rgba(250, 247, 242, 0.88);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    box-shadow: 0 1px 0 var(--nav-cream-3);
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  /* ── logo ── */
  .nav-logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    line-height: 1;
    text-decoration: none;
  }
  .logo-text {
    font-family: var(--nav-font-caveat);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--nav-ink);
    letter-spacing: 0.01em;
  }
  .logo-squiggle {
    width: 88px;
    height: 6px;
    color: var(--nav-teal);
  }

  /* ── nav links ── */
  .nav-links {
    display: flex;
    gap: 2.5rem;
  }
  .nav-link {
    font-family: var(--nav-font-clash);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nav-ink-3);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--nav-teal);
    border-radius: 2px;
    transition: width 0.3s var(--nav-expo);
  }
  .nav-link:hover {
    color: var(--nav-ink);
  }
  .nav-link:hover::after {
    width: 100%;
  }

  /* ── actions ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .nav-login {
    font-family: var(--nav-font-clash);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--nav-ink-3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-login:hover {
    color: var(--nav-ink);
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--nav-ink);
    color: var(--nav-cream);
    font-family: var(--nav-font-clash);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.65rem 1.25rem;
    border-radius: 100px;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.25s var(--nav-spring),
      box-shadow 0.25s;
  }
  .nav-cta svg {
    width: 15px;
    height: 15px;
    transition: transform 0.2s var(--nav-spring);
  }
  .nav-cta:hover {
    background: var(--nav-teal);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(61, 140, 128, 0.32);
  }
  .nav-cta:hover svg {
    transform: translateX(4px);
  }

  /* ── burger ── */
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 7px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    height: 1.5px;
    background: var(--nav-ink);
    border-radius: 2px;
    transition:
      transform 0.3s,
      opacity 0.3s;
    transform-origin: center;
  }
  .nav-burger.open span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-burger.open span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ── drawer ── */
  .nav-drawer {
    display: none;
    flex-direction: column;
    gap: 0.3rem;
    position: fixed;
    inset: 0;
    top: 0;
    padding: 5.5rem 2rem 2.5rem;
    background: rgba(250, 247, 242, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 800;
    border-bottom: 1px solid var(--nav-cream-3);
    transform: translateY(-100%);
    transition: transform 0.45s var(--nav-expo);
  }
  .nav-drawer.open {
    transform: translateY(0);
  }
  .nav-drawer a {
    font-family: var(--nav-font-caveat);
    font-size: 2rem;
    font-weight: 600;
    color: var(--nav-ink-2);
    padding: 0.4rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--nav-cream-3);
    transition: color 0.2s;
  }
  .nav-drawer a:last-child {
    border-bottom: none;
  }
  .nav-drawer a:hover,
  .drawer-cta {
    color: var(--nav-teal) !important;
  }

  /* ── responsive ── */
  @media (max-width: 1024px) {
    .nav-links,
    .nav-login {
      display: none;
    }
    .nav-burger {
      display: flex;
    }
    .nav-drawer {
      display: flex;
    }
  }
</style>

<div class="grain" aria-hidden="true"></div>
<div class="cursor" aria-hidden="true"></div>

<header class="nav" id="nav" role="banner">
  <a href="/" class="nav-logo" aria-label="Scriptorium home">
    <span class="logo-text">Scriptorium</span>
    <svg
      class="logo-squiggle"
      viewBox="0 0 120 8"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2 5 Q20 1 38 5 Q56 9 74 5 Q92 1 110 5 Q116 6.5 118 5"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        fill="none"
      />
    </svg>
  </a>

  <nav class="nav-links" aria-label="Main navigation">
    <a href="/#about" class="nav-link">About</a>
    <a href="/#rooms" class="nav-link">Rooms</a>
    <a href="/contact" class="nav-link">Contact</a>
    <a href="/#ai" class="nav-link">AI</a>
  </nav>

  <div class="nav-actions">
    <a href="/login" class="nav-login">Log in</a>
    <a href="/signup" class="nav-cta">
      Get started
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M4 10h12M12 6l4 4-4 4"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>
    <button class="nav-burger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>

  <div class="nav-drawer" aria-hidden="true">
    <a href="/#about">About</a>
    <a href="/#rooms">Rooms</a>
    <a href="/contact">Contact</a>
    <a href="/#ai">AI picks</a>
    <a href="/login">Log in</a>
    <a href="/signup" class="drawer-cta">Get started →</a>
  </div>
</header>
