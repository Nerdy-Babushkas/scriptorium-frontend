<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Verify Email — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/auth.css">
  <style>
    /* ── VERIFY PAGE SPECIFICS ───────────────────────────────── */
    .verify-wrap {
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      position: relative;
      z-index: 10;
    }

    .verify-card {
      background: #fff;
      border: 1.5px solid var(--cream-3);
      border-radius: 28px;
      padding: 3rem 2.5rem;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: var(--sh-hover);
      position: relative;
      overflow: hidden;
    }

    /* Rainbow top stripe */
    .verify-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--teal), var(--amber), var(--lavender), var(--rose));
    }

    /* Icon circle */
    .verify-icon {
      width: 80px; height: 80px; border-radius: 50%;
      margin: 0 auto 1.5rem;
      display: flex; align-items: center; justify-content: center;
      font-size: 2rem;
      transition: all 0.4s ease;
    }
    .verify-icon--loading {
      background: var(--teal-p);
      border: 1.5px solid var(--teal-l);
    }
    .verify-icon--success {
      background: var(--teal-p);
      border: 1.5px solid var(--teal-l);
    }
    .verify-icon--error {
      background: var(--rose-p);
      border: 1.5px solid rgba(192,88,104,0.3);
    }

    /* Spinner */
    .verify-spinner {
      width: 32px; height: 32px;
      border: 2.5px solid var(--teal-l);
      border-top-color: var(--teal);
      border-radius: 50%;
      animation: vspin 0.8s linear infinite;
    }
    @keyframes vspin { to { transform: rotate(360deg); } }

    .verify-title {
      font-family: var(--font-clash);
      font-size: 1.6rem; font-weight: 700;
      letter-spacing: -0.02em; color: var(--ink);
      margin-bottom: 0.5rem;
    }

    .verify-subtitle {
      font-size: 0.86rem; color: var(--ink-4);
      line-height: 1.6; margin-bottom: 1.5rem;
    }

    .verify-status {
      font-size: 0.88rem; font-weight: 600;
      line-height: 1.55; margin-bottom: 1.75rem;
      min-height: 1.4rem;
    }
    .verify-status--loading { color: var(--ink-4); }
    .verify-status--success { color: var(--teal); }
    .verify-status--error   { color: var(--rose); }

    /* CTA button */
    .verify-btn {
      display: inline-flex; align-items: center;
      justify-content: center; gap: 0.5rem;
      padding: 0.8rem 2rem; border-radius: 100px;
      background: var(--ink); color: var(--cream);
      font-family: var(--font-clash);
      font-size: 0.8rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      text-decoration: none;
      transition: background 0.2s, transform 0.25s var(--spring), box-shadow 0.25s;
    }
    .verify-btn:hover {
      background: var(--teal);
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(61,140,128,0.28);
    }
    .verify-btn svg { width: 15px; height: 15px; }

    .verify-home {
      display: block; margin-top: 0.85rem;
      font-size: 0.78rem; color: var(--ink-4);
      transition: color 0.2s;
    }
    .verify-home:hover { color: var(--ink); }
  </style>
</head>

<body class="auth-body">

  <div class="grain" aria-hidden="true"></div>
  <div class="page-orb page-orb-1" aria-hidden="true"
    style="position:fixed;border-radius:50%;filter:blur(88px);pointer-events:none;z-index:0;
           width:500px;height:500px;background:radial-gradient(circle,rgba(61,140,128,0.10),transparent 68%);
           top:-10%;left:-15%;"></div>
  <div class="page-orb page-orb-2" aria-hidden="true"
    style="position:fixed;border-radius:50%;filter:blur(88px);pointer-events:none;z-index:0;
           width:400px;height:400px;background:radial-gradient(circle,rgba(191,122,48,0.07),transparent 65%);
           bottom:5%;right:-8%;"></div>

  <div class="verify-wrap">
    <div class="verify-card">

      <div class="verify-icon verify-icon--loading" id="verifyIcon">
        <div class="verify-spinner" id="verifySpinner"></div>
      </div>

      <h1 class="verify-title" id="verifyTitle">Verifying your email</h1>
      <p class="verify-subtitle" id="verifySubtitle">Hang tight — we're confirming your account…</p>
      <p class="verify-status verify-status--loading" id="verifyStatus">Checking verification link…</p>

      <div id="verifyActions" style="display:none;">
        <a href="/login" class="verify-btn" id="verifyBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Continue to Login
        </a>
        <a href="/" class="verify-home">← Back to home</a>
      </div>

    </div>
  </div>

  <script>
    const BACKEND_URL = 'https://scriptorium-backend-six.vercel.app';
    const params = new URLSearchParams(window.location.search);
    const token  = params.get('token');

    const icon     = document.getElementById('verifyIcon');
    const spinner  = document.getElementById('verifySpinner');
    const title    = document.getElementById('verifyTitle');
    const subtitle = document.getElementById('verifySubtitle');
    const status   = document.getElementById('verifyStatus');
    const actions  = document.getElementById('verifyActions');
    const btn      = document.getElementById('verifyBtn');

    function showSuccess(msg) {
      spinner.style.display = 'none';
      icon.className = 'verify-icon verify-icon--success';
      icon.innerHTML = '✓';

      title.textContent    = 'You\'re all set!';
      subtitle.textContent = 'Your email has been verified successfully.';

      status.textContent = msg || 'Email verified — you can now log in.';
      status.className   = 'verify-status verify-status--success';

      actions.style.display = 'block';
    }

    function showError(msg) {
      spinner.style.display = 'none';
      icon.className = 'verify-icon verify-icon--error';
      icon.innerHTML = '✕';

      title.textContent    = 'Verification failed';
      subtitle.textContent = 'We couldn\'t verify your email with this link.';

      status.textContent = msg || 'The link may be expired or invalid.';
      status.className   = 'verify-status verify-status--error';

      actions.style.display = 'block';
      btn.textContent = 'Go to Login';
    }

    if (!token) {
      showError('Invalid verification link — no token was provided.');
    } else {
      fetch(`${BACKEND_URL}/api/user/verify?token=${token}`)
        .then(res => res.json().then(data => ({ status: res.status, data })))
        .then(({ status: s, data }) => {
          if (s === 200) showSuccess(data.message);
          else showError(data.message || 'Verification failed.');
        })
        .catch(() => showError('Something went wrong. Please try again later.'));
    }
  </script>

</body>
</html>
