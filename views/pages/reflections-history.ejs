<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Reflection History - Scriptorium' }) %>

    <style>
        /* Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
        .custom-scroll::-webkit-scrollbar-thumb { background: #00C49A; border-radius: 4px; }

        /* Highlight selected reflection */
        .highlighted {
            border: 2px solid #00C49A;
            background-color: rgba(0,196,154,0.1);
        }

        .animate-slide-up {
            animation: slideUp 0.4s ease-out forwards;
        }

        @keyframes slideUp {
            from { opacity:0; transform:translateY(20px); }
            to { opacity:1; transform:translateY(0); }
        }
    </style>
</head>

<body class="bg-[#2C1810] min-h-screen text-white font-outfit overflow-x-hidden">

<%- include('../partials/navbar_app') %>

<main class="container mx-auto px-4 py-8 max-w-6xl">

    <!-- Page Title -->
    <div class="text-center mb-8">
        <h1 class="font-dancing text-5xl text-white mb-2">
            All Reflections
        </h1>
        <p class="text-white/50 text-sm">
            Browse and revisit your thoughts
        </p>
    </div>

    <!-- Item Filter -->
    <div class="flex justify-center mb-6">
        <select
            id="itemSelect"
            class="px-4 py-2 rounded-lg bg-black/40 border border-white/10 text-white text-sm focus:outline-none focus:border-[#00C49A] transition-all"
        >
            <option value="">All Reflections</option>
        </select>
    </div>

    <!-- Loading -->
    <div id="loading"
         class="flex flex-col items-center justify-center text-white/30">
        <div class="w-8 h-8 border-2 border-[#00C49A] border-t-transparent rounded-full animate-spin mb-2"></div>
        Loading reflections...
    </div>

    <!-- Reflections Container -->
    <div id="historyContainer"
         class="space-y-4 custom-scroll hidden max-h-[70vh] overflow-y-auto">
    </div>

    <!-- Empty State -->
    <div id="emptyHistory"
         class="hidden flex flex-col items-center justify-center text-white/30 text-center mt-12">
        <p>No reflections yet.</p>
        <p class="text-xs mt-1">
            Go back and add a reflection first.
        </p>
    </div>

    <!-- Pagination -->
    <div id="pagination"
         class="hidden flex justify-center items-center gap-6 mt-6 text-sm text-white/70">

        <button
            id="prevPage"
            class="px-3 py-1 rounded border border-white/10 hover:bg-white/10 transition">
            ← Previous
        </button>

        <span id="pageIndicator">Page 1</span>

        <button
            id="nextPage"
            class="px-3 py-1 rounded border border-white/10 hover:bg-white/10 transition">
            Next →
        </button>

    </div>

</main>

<script src="/js/reflections-history.js"></script>

</body>
</html>