<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Scriptorium — Your Mind Space' }) %>
  <link rel="stylesheet" href="/css/landing.css">
  <meta name="description" content="Scriptorium — your personal digital mind space. Collect books, music, movies, podcasts. Write reflections, set goals, let AI guide what's next.">

  <%#
    FONTS
    Caveat          — handwritten display, loud & expressive (Google Fonts, free)
    Clash Display   — geometric bold sans (Fontshare, free)
    Instrument Serif — refined italic serif for accent em words
    DM Sans         — body text, clean & legible
  %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap" rel="stylesheet">
</head>

<body class="lp-body">

  <%# ── Texture overlays ── %>
  <div class="grain" aria-hidden="true"></div>

  <%# ── Custom cursor ── %>
  <div class="cursor" aria-hidden="true"></div>

  <%# ══════════════════════════════════════════════
      NAVBAR
  ══════════════════════════════════════════════ %>
  <header class="nav" id="nav" role="banner">
    <a href="/" class="nav-logo" aria-label="Scriptorium home">
      <span class="logo-text">Scriptorium</span>
      <svg class="logo-squiggle" viewBox="0 0 120 8" fill="none" aria-hidden="true">
        <path d="M2 5 Q20 1 38 5 Q56 9 74 5 Q92 1 110 5 Q116 6.5 118 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/>
      </svg>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      <a href="#about" class="nav-link">About</a>
      <a href="/room" class="nav-link">Rooms</a>
      <a href="/contact"   class="nav-link">Contact</a>
      <a href="#ai"    class="nav-link">AI</a>
    </nav>

    <div class="nav-actions">
      <a href="/login"  class="nav-login">Log in</a>
      <a href="/signup" class="nav-cta">
        Get started
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <button class="nav-burger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>

    <div class="nav-drawer" aria-hidden="true">
      <a href="#about">About</a>
      <a href="#rooms">Rooms</a>
      <a href="/contact">Contact</a>
      <a href="#ai">AI picks</a>
      <a href="/login">Log in</a>
      <a href="/signup" class="drawer-cta">Get started →</a>
    </div>
  </header>

  <main>

    <%# ══════════════════════════════════════════════
        HERO
        Layout: full-viewport two-column collage
        Left:  bold oversized headline + CTA
        Right: stacked collage media cards
        Background: floating illustrated SVG objects
    ══════════════════════════════════════════════ %>
    <section class="hero" aria-labelledby="hero-h1">

      <%# ── Floating illustrated objects ── %>

      <%# Book stack %>
      <div class="floater f-books" data-float="0" aria-hidden="true">
        <svg viewBox="0 0 110 120" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="6" y="22" width="86" height="18" rx="3" fill="#c9b99a" transform="rotate(-7 6 22)"/>
          <rect x="6" y="22" width="11" height="18" rx="2" fill="#a89878" transform="rotate(-7 6 22)"/>
          <rect x="4" y="44" width="90" height="22" rx="3" fill="#a8c4b8" transform="rotate(-2 4 44)"/>
          <rect x="4" y="44" width="12" height="22" rx="2" fill="#7aaa98" transform="rotate(-2 4 44)"/>
          <rect x="2" y="70" width="94" height="26" rx="3" fill="#d4a8a8" transform="rotate(3 2 70)"/>
          <rect x="2" y="70" width="13" height="26" rx="2" fill="#bc8888" transform="rotate(3 2 70)"/>
          <path d="M70 70 L70 90 L65 85 L60 90 L60 70Z" fill="#e8c87a"/>
          <ellipse cx="52" cy="104" rx="44" ry="5" fill="rgba(0,0,0,0.07)"/>
        </svg>
      </div>

      <%# Film reel %>
      <div class="floater f-reel" data-float="2" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="44" fill="#2d2d2d"/>
          <circle cx="50" cy="12" r="5" fill="#111"/>
          <circle cx="50" cy="88" r="5" fill="#111"/>
          <circle cx="12" cy="50" r="5" fill="#111"/>
          <circle cx="88" cy="50" r="5" fill="#111"/>
          <circle cx="22" cy="22" r="5" fill="#111"/>
          <circle cx="78" cy="78" r="5" fill="#111"/>
          <circle cx="78" cy="22" r="5" fill="#111"/>
          <circle cx="22" cy="78" r="5" fill="#111"/>
          <circle cx="50" cy="50" r="22" fill="#111"/>
          <circle cx="50" cy="50" r="15" fill="#c4843c"/>
          <circle cx="50" cy="50" r="7"  fill="#111"/>
        </svg>
      </div>

 <%#  Plain Sticky Note  %>
<div class="floater f-note" data-float="3" 
     style="position: absolute; left: 45%; top: 55%; transform: translate(-50%, -50%) rotate(-3deg); z-index: 2;" 
     aria-hidden="true">
  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.15));">
    
    
    <%# The Main Top Page %>
    <rect x="5" y="5" width="88" height="88" rx="2" fill="#f5e87a" />
    
    
    <%# Hand-drawn Style Lines %>
    <line x1="15" y1="30" x2="75" y2="28" stroke="#c8b840" stroke-width="2" stroke-linecap="round" />
    <line x1="15" y1="45" x2="80" y2="43" stroke="#c8b840" stroke-width="2" stroke-linecap="round" />
    <line x1="15" y1="60" x2="60" y2="58" stroke="#c8b840" stroke-width="2" stroke-linecap="round" />
    
    <%# Subtle Bottom Lift (Makes it look like paper, not a flat box) %>
    <path d="M5 93 Q50 96 93 93" stroke="#d6c550" stroke-width="0.5" fill="none" />
  </svg>
</div>

      <%# Small amber star %>
      <div class="floater f-star2" data-float="1" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none">
          <path d="M20 2L22.8 16.2L37 20L22.8 23.8L20 38L17.2 23.8L3 20L17.2 16.2Z" fill="#c4843c"/>
        </svg>
      </div>


      <%# ── MAIN HERO CONTENT ── %>

          <%# ── MAIN HERO CONTENT ── %>
      <div class="hero-inner">

        <%# Left: text block %>
        <div class="hero-text">

          <h1 class="hero-h1" id="hero-h1" data-animate="fade-up" data-delay="1">
            <span class="h1-clash">A space to</span>
            <span class="h1-caveat">think, <em>feel,</em></span>
            <span class="h1-clash h1-bleed">and collect.</span>
          </h1>

          <%# SVG squiggly underline under headline %>
          <svg class="headline-wave" viewBox="0 0 480 14" fill="none" aria-hidden="true" data-animate="fade-up" data-delay="2">
            <path d="M4 8 Q80 2 160 9 Q240 16 320 8 Q400 1 476 8" stroke="#4a9b8e" stroke-width="3.5" stroke-linecap="round" fill="none"/>
          </svg>

          <p class="hero-sub" data-animate="fade-up" data-delay="2">
            Save what moves you. Write what it meant.<br>Let AI find what's next.
          </p>

          <div class="hero-actions" data-animate="fade-up" data-delay="3">
            <a href="/signup" class="btn-primary">
              Start your space
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#about" class="btn-ghost">See how it works</a>
          </div>

          <div class="hero-proof" data-animate="fade-up" data-delay="4">
            <div class="proof-item"><strong>4</strong><span>Rooms</span></div>
            <span class="proof-dot" aria-hidden="true">·</span>
            <div class="proof-item"><strong>∞</strong><span>Reflections</span></div>
            <span class="proof-dot" aria-hidden="true">·</span>
            <div class="proof-item"><strong>AI</strong><span>Powered picks</span></div>
          </div>

        </div>

        <%# Right: collage of media cards %>
        <div class="hero-collage" data-animate="fade-left" data-delay="2" aria-hidden="true">

          <div class="cc cc-book">
            <div class="cc-spine"></div>
            <div class="cc-body">
              <div class="cc-label"> Currently reading</div>
              <strong>House of Leaves</strong>
              <small>Mark Z. Danielewski</small>
              <div class="cc-bar-wrap">
                <div class="cc-bar" style="--p:64% Complete"></div>
                <span>64%</span>
              </div>
            </div>
          </div>

          <div class="cc cc-music">
            <div class="cc-label"> Saved album</div>
            <div class="cc-vinyl">
              <div class="vinyl-ring r1"></div>
              <div class="vinyl-ring r2"></div>
              <div class="vinyl-ring r3"></div>
              <div class="vinyl-center"></div>
            </div>
            <strong>Bicep by Isles</strong>
            <small>Late night listening</small>
          </div>

          <div class="cc cc-note">
            <div class="cc-label"> Reflection</div>
            <p class="cc-quote">"The architecture of this book mirrors the labyrinth inside it. Can't stop thinking about it."</p>
            <small class="cc-date">Chapter 4 · 2 days ago</small>
          </div>

          <div class="cc cc-film">
            <div class="cc-label"> Watchlist</div>
            <div class="cc-filmstrip">
              <div class="fs-frame"></div>
              <div class="fs-frame"></div>
              <div class="fs-frame"></div>
            </div>
            <strong>Everything Everywhere<br>All at Once</strong>
          </div>

        </div>
      </div>

      <%# Scroll cue %>
      <div class="scroll-cue" aria-hidden="true">
        <div class="scroll-line"></div>
      </div>

    </section>


    <%# ── MARQUEE ── %>
    <div class="marquee-wrap" aria-hidden="true">
      <div class="marquee-track">
        <span>Books</span><span class="msep">·</span>
        <span>Music</span><span class="msep">·</span>
        <span>Movies</span><span class="msep">·</span>
        <span>Podcasts</span><span class="msep">·</span>
        <span>Reflections</span><span class="msep">·</span>
        <span>Goals</span><span class="msep">·</span>
        <span>AI Picks</span><span class="msep">·</span>
        <span>Your Room</span><span class="msep">·</span>
        <span>Books</span><span class="msep">·</span>
        <span>Music</span><span class="msep">·</span>
        <span>Movies</span><span class="msep">·</span>
        <span>Podcasts</span><span class="msep">·</span>
        <span>Reflections</span><span class="msep">·</span>
        <span>Goals</span><span class="msep">·</span>
        <span>AI Picks</span><span class="msep">·</span>
        <span>Your Room</span><span class="msep">·</span>
      </div>
    </div>

    <%# ══════════════════════════════════════════════
        ABOUT — bento
    ══════════════════════════════════════════════ %>
    <section id="about" class="section" aria-labelledby="about-h2">
      <div class="section-header">
        <p class="eyebrow" data-reveal> How it works</p>
        <h2 class="section-h2" data-reveal data-reveal-delay="1" id="about-h2">
          Everything in
          <span class="h2-caveat">one room.</span>
        </h2>
      </div>

      <div class="bento" role="list">

      <article class="bento-card bento-wide" data-reveal role="listitem">
  <div class="bento-noise" aria-hidden="true"></div>
  <div class="bento-inner">
    <h3>Your personal library</h3>
    <p>A curated archive of the media that shapes you. Scriptorium is the digital shelf for your physical and mental collection built to <em>remember</em>, not just to stream.</p>
    <span class="btag btag-teal">Collect</span>
  </div>
  
  <%# Creative Stack: Book + Vinyl + Film Frame %>
  <div class="bento-stack-visual" aria-hidden="true" style="position: absolute; right: 30px; bottom: 20px; display: flex; align-items: flex-end; gap: -10px;">
    <%# The Book %>
    <div style="width: 45px; height: 80px; background: #c9b99a; border-radius: 4px 2px 2px 4px; border-left: 4px solid rgba(0,0,0,0.1); transform: rotate(-5deg); z-index: 3;"></div>
    <%# The Vinyl Sleeve %>
    <div style="width: 75px; height: 75px; background: #2d2d2d; border-radius: 4px; margin-left: -20px; transform: rotate(2deg); z-index: 2; display: flex; align-items: center; justify-content: center;">
      <div style="width: 65px; height: 65px; border-radius: 50%; border: 1px dashed rgba(255,255,255,0.1);"></div>
    </div>
    <%# The Film Frame %>
    <div style="width: 50px; height: 35px; background: #1a1a1a; border: 2px solid #4a9b8e; border-radius: 4px; margin-left: -15px; transform: rotate(10deg); z-index: 1;"></div>
  </div>
</article>

        <article class="bento-card bento-half" data-reveal data-reveal-delay="1" role="listitem">
          <div class="bento-noise" aria-hidden="true"></div>
          <div class="bento-inner">
            <h3>Write what it meant</h3>
            <p>Attach reflections to any chapter, album, or episode. Your thoughts, right where they belong.</p>
            <span class="btag btag-lavender">Reflect</span>
          </div>
          <div class="blines" aria-hidden="true">
            <div class="bl" style="width:100%"></div>
            <div class="bl" style="width:70%"></div>
            <div class="bl" style="width:85%"></div>
            <div class="bl" style="width:50%"></div>
          </div>
        </article>

      <article class="bento-card bento-third" data-reveal data-reveal-delay="1" role="listitem">
  <div class="bento-noise" aria-hidden="true"></div>
  <div class="bento-inner">
    <h3>Set goals</h3>
    <p>Finish that 800 page classic or explore a director's entire career. Track milestones, not just numbers.</p>
    <span class="btag btag-rose">Track</span>
  </div>
  
  <%# Linear Progress Path %>
  <div class="goal-timeline" aria-hidden="true" style="margin-top: 1.5rem; padding: 0 10px;">
    <div style="width: 100%; height: 2px; background: rgba(255,255,255,0.1); position: relative; display: flex; justify-content: space-between; align-items: center;">
      <div style="width: 8px; height: 8px; background: var(--rose); border-radius: 50%;"></div>
      <div style="width: 8px; height: 8px; background: var(--rose); border-radius: 50%;"></div>
      <div style="width: 12px; height: 12px; border: 2px solid var(--rose); background: #111; border-radius: 50%;"></div>
      <div style="width: 8px; height: 8px; background: rgba(255,255,255,0.2); border-radius: 50%;"></div>
      <%# Active Progress Line %>
      <div style="position: absolute; left: 0; top: 0; width: 50%; height: 2px; background: var(--rose);"></div>
    </div>
    <div style="font-size: 0.7rem; color: var(--rose); margin-top: 10px; font-family: monospace;">2 / 4 COMPLETED</div>
  </div>
</article>

      <article class="bento-card bento-third" data-reveal data-reveal-delay="2" role="listitem">
  <div class="bento-noise" aria-hidden="true"></div>
  <div class="bento-inner">
    <div class="room-portal" aria-hidden="true" style="margin-bottom: 1rem; height: 60px; display: flex; align-items: flex-end; gap: 4px;">
       <%# Abstract "Pillars/Books" that look like a room silhouette %>
       <div style="width: 12px; height: 40%; background: var(--amber); opacity: 0.3; border-radius: 4px 4px 0 0;"></div>
       <div style="width: 12px; height: 70%; background: var(--amber); opacity: 0.6; border-radius: 4px 4px 0 0;"></div>
       <div style="width: 12px; height: 100%; background: var(--amber); border-radius: 4px 4px 0 0;"></div>
       <div style="width: 12px; height: 60%; background: var(--amber); opacity: 0.4; border-radius: 4px 4px 0 0;"></div>
    </div>
    <h3>Themed rooms</h3>
    <p>Navigate your library, theatre, and music room through specialized interfaces.</p>
    <span class="btag btag-amber">Explore</span>
  </div>
</article>

        <article class="bento-card bento-third" data-reveal data-reveal-delay="3" role="listitem">
          <div class="bento-noise" aria-hidden="true"></div>
          <div class="bento-inner">
            <span class="bento-icon" aria-hidden="true">✦</span>
            <h3>AI-powered picks</h3>
            <p>Recommendations from your taste, mood and patterns.</p>
            <span class="btag btag-teal">Discover</span>
          </div>
        </article>
        

      </div>
    </section>

    <%# ══════════════════════════════════════════════
        ROOMS
    ══════════════════════════════════════════════ %>
    <section id="rooms" class="section rooms-section" aria-labelledby="rooms-h2">
      <div class="rooms-head">
        <div>
          <p class="eyebrow" data-reveal> Your virtual space</p>
          <h2 class="section-h2" data-reveal data-reveal-delay="1" id="rooms-h2">
            Pick a <span class="h2-caveat">room.</span>
          </h2>
        </div>
        <div class="rooms-bleed" aria-hidden="true">ROOMS</div>
      </div>

      <div class="rooms-grid" role="list">

        <article class="room-card room-lib" data-reveal role="listitem">
          <div class="room-noise" aria-hidden="true"></div>
          <span class="room-num" aria-hidden="true">01</span>
          <div class="room-icon-wrap" aria-hidden="true">
            <span class="room-icon">📖</span>
            <div class="room-glow"></div>
          </div>
          <div class="room-info">
            <h3>The Library</h3>
            <p>Books, annotations, reading progress. Your literary universe.</p>
            <a href="/signup" class="room-enter" tabindex="-1">Enter the room →</a>
          </div>
        </article>

        <article class="room-card room-music" data-reveal data-reveal-delay="1" role="listitem">
          <div class="room-noise" aria-hidden="true"></div>
          <span class="room-num" aria-hidden="true">02</span>
          <div class="room-icon-wrap" aria-hidden="true">
            <span class="room-icon">🎵</span>
            <div class="room-glow"></div>
          </div>
          <div class="room-info">
            <h3>Music Room</h3>
            <p>Albums that define a moment. Write what the music made you feel.</p>
            <a href="/signup" class="room-enter" tabindex="-1">Enter the room →</a>
          </div>
        </article>

        <article class="room-card room-theatre" data-reveal data-reveal-delay="2" role="listitem">
          <div class="room-noise" aria-hidden="true"></div>
          <span class="room-num" aria-hidden="true">03</span>
          <div class="room-icon-wrap" aria-hidden="true">
            <span class="room-icon">🎬</span>
            <div class="room-glow"></div>
          </div>
          <div class="room-info">
            <h3>The Theatre</h3>
            <p>Films seen, films to see. Rate, reflect, revisit.</p>
            <a href="/signup" class="room-enter" tabindex="-1">Enter the room →</a>
          </div>
        </article>

        <article class="room-card room-pod" data-reveal data-reveal-delay="3" role="listitem">
          <div class="room-noise" aria-hidden="true"></div>
          <span class="room-num" aria-hidden="true">04</span>
          <div class="room-icon-wrap" aria-hidden="true">
            <span class="room-icon">🎙</span>
            <div class="room-glow"></div>
          </div>
          <div class="room-info">
            <h3>Podcast Den</h3>
            <p>Log episodes, save quotes, keep ideas that struck you.</p>
            <a href="/signup" class="room-enter" tabindex="-1">Enter the room →</a>
          </div>
        </article>

      </div>
    </section>

    <%# ══════════════════════════════════════════════
        AI
    ══════════════════════════════════════════════ %>
    <section id="ai" class="section ai-section" aria-labelledby="ai-h2">
      <div class="ai-layout">

        <div class="ai-left">
          <p class="eyebrow" data-reveal> Powered by AI</p>
          <h2 class="section-h2" data-reveal data-reveal-delay="1" id="ai-h2">
            Picks that<br>
            <span class="h2-caveat">actually</span><br>
            get you.
          </h2>
          <p class="ai-body" data-reveal data-reveal-delay="2">
            Scriptorium reads the patterns in what you save and reflect on then surfaces the next thing you'll love, before you know to look.
          </p>
          <div class="ai-tabs" role="tablist" data-reveal data-reveal-delay="3">
            <button class="ai-tab is-active" role="tab" data-tab="taste" aria-selected="true">Your tastes</button>
            <button class="ai-tab" role="tab" data-tab="trend" aria-selected="false">Trending</button>
            <button class="ai-tab" role="tab" data-tab="mood" aria-selected="false">Your mood</button>
          </div>
        </div>

        <div class="ai-right" data-reveal data-reveal-delay="2">

          <div class="ai-stack" data-tab-panel="taste">
            <div class="ai-card ai-card--1">
              <div class="ai-dot ai-dot--teal"></div>
              <div class="ai-info"><strong>Piranesi</strong><span>Because you loved House of Leaves</span></div>
              <span class="ai-type">Book</span>
            </div>
            <div class="ai-card ai-card--2">
              <div class="ai-dot ai-dot--amber"></div>
              <div class="ai-info"><strong>Bicep by Isles</strong><span>Matches your late night listening</span></div>
              <span class="ai-type">Album</span>
            </div>
            <div class="ai-card ai-card--3">
              <div class="ai-dot ai-dot--lavender"></div>
              <div class="ai-info"><strong>Everything Everywhere All at Once</strong><span>Your reflection patterns say: watch this</span></div>
              <span class="ai-type">Film</span>
            </div>
          </div>

          <div class="ai-stack is-hidden" data-tab-panel="trend">
            <div class="ai-card ai-card--1">
              <div class="ai-dot ai-dot--rose"></div>
              <div class="ai-info"><strong>Fourth Wing</strong><span>Everyone's reading it, here's why</span></div>
              <span class="ai-type">Book</span>
            </div>
            <div class="ai-card ai-card--2">
              <div class="ai-dot ai-dot--teal"></div>
              <div class="ai-info"><strong>Chappell Roan</strong><span>Trending in your genre circle</span></div>
              <span class="ai-type">Music</span>
            </div>
            <div class="ai-card ai-card--3">
              <div class="ai-dot ai-dot--amber"></div>
              <div class="ai-info"><strong>Dune: Part Two</strong><span>The sequel everyone's talking about</span></div>
              <span class="ai-type">Film</span>
            </div>
          </div>

          <div class="ai-stack is-hidden" data-tab-panel="mood">
            <div class="ai-card ai-card--1">
              <div class="ai-dot ai-dot--lavender"></div>
