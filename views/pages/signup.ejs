    </div>

    <%# ══════════════════════════════════════════════
        RIGHT PANEL — signup form
        IDs preserved exactly for signup.js:
          signupForm, email, password, confirmPassword,
          togglePassword, toggleConfirmPassword,
          submitBtn, formMessage
    ══════════════════════════════════════════════ %>
    <div class="auth-panel-right">
      <div class="auth-form-wrap">

        <div class="auth-heading">
          <p class="auth-eyebrow">Create account</p>
          <h1>
            Welcome<br>
            <span class="caveat-word">aboard.</span>
          </h1>
          <p class="auth-heading-sub">
            Already have an account?
            <a href="/login">Log in instead →</a>
          </p>
        </div>

        <form class="auth-form" id="signupForm" novalidate>

          <div class="auth-field">
            <label class="auth-label" for="email">Email</label>
            <input
              class="auth-input"
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="auth-field">
            <label class="auth-label" for="password">Password</label>
            <div class="auth-input-wrap">
              <input
                class="auth-input"
                type="password"
                id="password"
                name="password"
                placeholder="Create a strong password"
                autocomplete="new-password"
                required
              />
              <%# id="togglePassword" preserved exactly for signup.js %>
              <button
                type="button"
                class="auth-toggle-btn"
                id="togglePassword"
                data-visible="false"
                aria-label="Show password"
              ></button>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="confirmPassword">Confirm Password</label>
            <div class="auth-input-wrap">
              <input
                class="auth-input"
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Repeat your password"
                autocomplete="new-password"
                required
              />
              <%# id="toggleConfirmPassword" preserved exactly for signup.js %>
              <button
                type="button"
                class="auth-toggle-btn"
                id="toggleConfirmPassword"
                data-visible="false"
                aria-label="Show confirm password"
              ></button>
            </div>
          </div>

          <%#
            id="formMessage" preserved exactly for signup.js.
            signup.js sets className directly — our CSS detects
            "bg-red-500/10" and "bg-green-500/10" substrings via [class*=].
            The .hidden class is also respected.
          %>
          <div id="formMessage" role="alert" aria-live="polite"></div>

          <%# id="submitBtn" preserved exactly for signup.js %>
          <button type="submit" id="submitBtn">
            Create your room
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

        </form>

