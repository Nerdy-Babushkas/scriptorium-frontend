  </div>

  <%# Backend logic — untouched, exactly as provided %>
  <script src="/js/signup.js" defer></script>

  <%#
    Inline auth UI script — replaces auth-nav.js entirely.
    Handles: custom cursor, hover states, and eye-toggle data-attribute sync.
    Does NOT touch signup form logic — that is 100% owned by signup.js.
  %>
  <script>
    (function () {
      /* ── CUSTOM CURSOR ─────────────────────────────────────── */
      const cursor = document.getElementById('authCursor');
      if (cursor && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let cx = -100, cy = -100;
        let raf;

        document.addEventListener('mousemove', (e) => {
          cx = e.clientX - 6;
          cy = e.clientY - 6;
          if (!raf) {
            raf = requestAnimationFrame(() => {
              cursor.style.transform = 'translate3d(' + cx + 'px,' + cy + 'px,0)';
              raf = null;
            });
          }
        });

        document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; });
        document.addEventListener('mouseenter', () => { cursor.style.opacity = ''; });

        const hovEls = 'a, button, input, label, [role="button"]';
        document.addEventListener('mouseover', (e) => {
          if (e.target.closest(hovEls)) cursor.classList.add('hov');
        });
        document.addEventListener('mouseout', (e) => {
          if (e.target.closest(hovEls)) cursor.classList.remove('hov');
        });

        document.addEventListener('mousedown', () => cursor.classList.add('clicking'));
        document.addEventListener('mouseup',   () => cursor.classList.remove('clicking'));
      }

      /* ── EYE TOGGLES — sync data-visible for both fields ──── */
      /*
        signup.js owns the click handlers and swaps input.type.
        We piggyback on the same clicks to sync the data-visible attribute
        so CSS can swap between the open-eye and crossed-eye SVG icons.
        We attach AFTER signup.js DOMContentLoaded handlers run (window load).
      */
      function syncEyeToggle(btnId, inputId) {
        const btn   = document.getElementById(btnId);
        const input = document.getElementById(inputId);
        if (!btn || !input) return;

        btn.addEventListener('click', () => {
          // signup.js has already toggled input.type at this point
          const isVisible = input.type === 'text';
          btn.setAttribute('data-visible', isVisible ? 'true' : 'false');
          btn.setAttribute('aria-label', isVisible ? 'Hide password' : 'Show password');
        });
      }

      window.addEventListener('load', () => {
        syncEyeToggle('togglePassword',        'password');
        syncEyeToggle('toggleConfirmPassword', 'confirmPassword');
      });

    })();
  </script>

</body>
</html>