<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Log In — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/auth.css">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap" rel="stylesheet">
</head>

<body class="auth-body">

  <div class="grain" aria-hidden="true"></div>

  <%# Custom cursor — must be in DOM for JS to find it %>
  <div class="cursor" id="authCursor" aria-hidden="true"></div>

  <%# Back button %>
  <a href="/" class="auth-back" aria-label="Back to home">
    <span class="auth-back-arrow">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="auth-back-label">
      <span class="auth-back-label-text">Scriptorium</span>
      <svg class="auth-back-squiggle" viewBox="0 0 60 5" fill="none" aria-hidden="true">
        <path d="M1 3 Q10 1 20 3 Q30 5 40 3 Q50 1 59 3" stroke="#3d8c80" stroke-width="1.8" stroke-linecap="round" fill="none"/>
      </svg>
    </span>
  </a>

  <%#
    Login layout: form LEFT, panel RIGHT
    auth-page--login triggers grid-reverse via CSS.
  %>
  <div class="auth-page auth-page--login">

    <%# ══════════════════════════════════════════════
        FORM PANEL
        IDs preserved exactly for login.js:
          loginForm, email, password, togglePassword
        Note: login.js creates #loginMessage itself via JS (prepend),
        so we do NOT put a #formMessage inside the form here.
    ══════════════════════════════════════════════ %>
    <div class="auth-panel-right">
      <div class="auth-form-wrap">

        <div class="auth-heading">
          <p class="auth-eyebrow">Welcome back</p>
          <h1>
            Good to<br>
            <span class="caveat-word">see you.</span>
          </h1>
          <p class="auth-heading-sub">
            Don't have an account yet?
            <a href="/signup">Sign up free →</a>
          </p>
        </div>

        <form class="auth-form" id="loginForm" novalidate>

          <div class="auth-field">
            <label class="auth-label" for="email">Email</label>
            <input
              class="auth-input"
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div class="auth-field">
            <label class="auth-label" for="password">Password</label>
            <div class="auth-input-wrap">
              <input
                class="auth-input"
                type="password"
                id="password"
                name="password"
                placeholder="Your password"
                autocomplete="current-password"
                required
              />
              <%# id="togglePassword" preserved exactly for login.js %>
              <button
                type="button"
                class="auth-toggle-btn"
                id="togglePassword"
                data-visible="false"
                aria-label="Show password"
              ></button>
            </div>
          </div>

          <a href="/forgot-password" class="auth-forgot">Forgot your password?</a>

          <%#
            login.js prepends its own #loginMessage div to the form via JS.
            We do NOT place a static message div here — login.js owns it.
            The CSS targets #loginMessage via [class*="bg-red"] / [class*="bg-green"].
          %>

          <button type="submit" id="submitBtn">
            Log in
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

        </form>

        <div class="auth-divider">or continue with</div>

        <div class="auth-socials">

          <button type="button" class="auth-social-btn">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M36.3425 16.7358H35V16.6666H20V23.3333H29.4191C28.045 27.2141 24.3525 29.9999 20 29.9999C14.4775 29.9999 9.99998 25.5224 9.99998 19.9999C9.99998 14.4774 14.4775 9.99992 20 9.99992C22.5491 9.99992 24.8683 10.9616 26.6341 12.5324L31.3483 7.81825C28.3716 5.04409 24.39 3.33325 20 3.33325C10.7958 3.33325 3.33331 10.7958 3.33331 19.9999C3.33331 29.2041 10.7958 36.6666 20 36.6666C29.2041 36.6666 36.6666 29.2041 36.6666 19.9999C36.6666 18.8824 36.5516 17.7916 36.3425 16.7358Z" fill="#FFC107"/>
              <path d="M5.255 12.2424L10.7308 16.2583C12.2125 12.5899 15.8008 9.99992 20 9.99992C22.5492 9.99992 24.8683 10.9616 26.6342 12.5324L31.3483 7.81825C28.3717 5.04409 24.39 3.33325 20 3.33325C13.5983 3.33325 8.04667 6.94742 5.255 12.2424Z" fill="#FF3D00"/>
              <path d="M20 36.6668C24.305 36.6668 28.2166 35.0192 31.1741 32.3401L26.0158 27.9751C24.2866 29.291 22.173 30.0024 20 30.0001C15.665 30.0001 11.9841 27.2359 10.5975 23.3784L5.16248 27.5659C7.92081 32.9634 13.5225 36.6668 20 36.6668Z" fill="#4CAF50"/>
              <path d="M36.3425 16.7359H35V16.6667H20V23.3334H29.4192C28.7618 25.1804 27.5778 26.7944 26.0133 27.9759L26.0158 27.9742L31.1742 32.3392C30.8092 32.6709 36.6667 28.3334 36.6667 20.0001C36.6667 18.8826 36.5517 17.7917 36.3425 16.7359Z" fill="#1976D2"/>
            </svg>
            Continue with Google
          </button>

          <button type="button" class="auth-social-btn">
            <svg viewBox="0 0 39 39" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M39 19.5C39 8.73052 30.2695 0 19.5 0C8.73052 0 0 8.73052 0 19.5C0 29.2329 7.13091 37.3003 16.4531 38.7631V25.1367H11.502V19.5H16.4531V15.2039C16.4531 10.3167 19.3644 7.61719 23.8186 7.61719C25.9521 7.61719 28.1836 7.99805 28.1836 7.99805V12.7969H25.7248C23.3023 12.7969 22.5469 14.3001 22.5469 15.8422V19.5H27.9551L27.0905 25.1367H22.5469V38.7631C31.8691 37.3003 39 29.2331 39 19.5Z" fill="#1877F2"/>
              <path d="M27.0905 25.1367L27.9551 19.5H22.5469V15.8422C22.5469 14.2999 23.3023 12.7969 25.7248 12.7969H28.1836V7.99805C28.1836 7.99805 25.9521 7.61719 23.8185 7.61719C19.3644 7.61719 16.4531 10.3167 16.4531 15.2039V19.5H11.502V25.1367H16.4531V38.7631C17.4611 38.921 18.4798 39.0002 19.5 39C20.5202 39.0002 21.5389 38.921 22.5469 38.7631V25.1367H27.0905Z" fill="white"/>
            </svg>
            Continue with Facebook
          </button>

        </div>

      </div>
    </div>

    <%# ══════════════════════════════════════════════
        DECORATIVE PANEL — right on login
    ══════════════════════════════════════════════ %>
    <div class="auth-panel-left auth-panel-left--login" aria-hidden="true">
      <div class="auth-panel-noise"></div>

      <div class="auth-bleed-word">READ</div>

      <div class="auth-floater auth-floater--headphones">
        <svg viewBox="0 0 100 96" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 50 Q20 22 50 22 Q80 22 80 50" stroke="#2d2d2d" stroke-width="6" stroke-linecap="round" fill="none"/>
          <rect x="10" y="48" width="18" height="30" rx="9" fill="#3d8c80"/>
          <rect x="72" y="48" width="18" height="30" rx="9" fill="#3d8c80"/>
          <rect x="14" y="52" width="10" height="22" rx="5" fill="#7abcb4"/>
          <rect x="76" y="52" width="10" height="22" rx="5" fill="#7abcb4"/>
          <path d="M50 80 Q50 90 42 92 Q38 93 38 96" stroke="#2d2d2d" stroke-width="2.5" stroke-linecap="round" fill="none"/>
          <circle cx="38" cy="96" r="3" fill="#e8c87a"/>
        </svg>
      </div>

      <div class="auth-floater auth-floater--reel">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="44" fill="#2d2d2d"/>
          <circle cx="50" cy="12" r="5" fill="#111"/>
          <circle cx="50" cy="88" r="5" fill="#111"/>
          <circle cx="12" cy="50" r="5" fill="#111"/>
          <circle cx="88" cy="50" r="5" fill="#111"/>
          <circle cx="22" cy="22" r="5" fill="#111"/>
          <circle cx="78" cy="78" r="5" fill="#111"/>
          <circle cx="78" cy="22" r="5" fill="#111"/>
          <circle cx="22" cy="78" r="5" fill="#111"/>
          <circle cx="50" cy="50" r="22" fill="#111"/>
          <circle cx="50" cy="50" r="15" fill="#bf7a30"/>
          <circle cx="50" cy="50" r="7"  fill="#111"/>
        </svg>
      </div>

      <div class="auth-floater auth-floater--star">
        <svg viewBox="0 0 60 60" fill="none">
          <path d="M30 4L33 26L55 30L33 34L30 56L27 34L5 30L27 26Z" fill="#7a68c0" opacity="0.55"/>
        </svg>
      </div>

      <div class="auth-floater auth-floater--star2">
        <svg viewBox="0 0 40 40" fill="none">
          <path d="M20 2L22.8 16.2L37 20L22.8 23.8L20 38L17.2 23.8L3 20L17.2 16.2Z" fill="#bf7a30" opacity="0.6"/>
        </svg>
      </div>

      <div class="auth-floater auth-floater--arc">
        <svg viewBox="0 0 150 50" fill="none">
          <path d="M4 36 Q32 4 62 26 Q92 48 122 16 Q136 7 148 14"
            stroke="#bf7a30" stroke-width="2.8" stroke-linecap="round"
            fill="none" opacity="0.38" stroke-dasharray="5 4"/>
        </svg>
      </div>

      <div class="auth-panel-tagline">
        <p class="auth-panel-eyebrow">— Pick up where you left off</p>
        <h2>
          Your <span class="caveat-word">space</span><br>awaits.
        </h2>
        <p>Your reflections, rooms, and progress right where you left them.</p>
      </div>

      <div class="auth-preview-cards">
        <div class="auth-preview-card">
          <div class="apc-dot apc-dot--lavender"></div>
          <div class="apc-text">
            <strong>Meditation journal</strong>
            <span>Last reflection · 3 days ago</span>
          </div>
          <span class="apc-badge">Note</span>
        </div>
        <div class="auth-preview-card">
          <div class="apc-dot apc-dot--teal"></div>
          <div class="apc-text">
            <strong>Reading goal : 12 books</strong>
            <span>68% complete · on track</span>
          </div>
          <span class="apc-badge">Goal</span>
        </div>
      </div>

    </div>

  </div>

  <%# Backend logic — untouched, exactly as provided %>
  <script src="/js/login.js" defer></script>

  <%#
    Inline auth UI script — replaces auth-nav.js entirely.
    Handles: custom cursor, hover states, and eye-toggle data-attribute sync.
    Does NOT touch login form logic — that is 100% owned by login.js.
  %>
  <script>
    (function () {
      /* ── CUSTOM CURSOR ─────────────────────────────────────── */
      const cursor = document.getElementById('authCursor');
      if (cursor && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let cx = -100, cy = -100;
        let raf;

        document.addEventListener('mousemove', (e) => {
          cx = e.clientX - 6; // offset half cursor width
          cy = e.clientY - 6;
          if (!raf) {
            raf = requestAnimationFrame(() => {
              cursor.style.transform = 'translate3d(' + cx + 'px,' + cy + 'px,0)';
              raf = null;
            });
          }
        });

        document.addEventListener('mouseleave', () => {
          cursor.style.opacity = '0';
        });
        document.addEventListener('mouseenter', () => {
          cursor.style.opacity = '';
        });

        /* Expand cursor on interactive elements */
        const hovEls = 'a, button, input, label, [role="button"]';
        document.addEventListener('mouseover', (e) => {
          if (e.target.closest(hovEls)) cursor.classList.add('hov');
        });
        document.addEventListener('mouseout', (e) => {
          if (e.target.closest(hovEls)) cursor.classList.remove('hov');
        });

        /* Click feedback */
        document.addEventListener('mousedown', () => cursor.classList.add('clicking'));
        document.addEventListener('mouseup',   () => cursor.classList.remove('clicking'));
      }

      /* ── EYE TOGGLE — sync data-visible attribute ──────────── */
      /*
        login.js owns the click handler and swaps input type.
        We piggyback on the same click to sync the data-visible attribute
        so CSS can swap between the open-eye and crossed-eye icons.
        We do this AFTER login.js runs (DOMContentLoaded + defer ordering).
      */
      function syncEyeToggle(btn, input) {
        if (!btn || !input) return;
        btn.addEventListener('click', () => {
          // login.js has already toggled the type at this point
          const isVisible = input.getAttribute('type') === 'text';
          btn.setAttribute('data-visible', isVisible ? 'true' : 'false');
          btn.setAttribute('aria-label', isVisible ? 'Hide password' : 'Show password');
        });
      }

      // Run after login.js DOMContentLoaded handlers have fired
      window.addEventListener('load', () => {
        syncEyeToggle(
          document.getElementById('togglePassword'),
          document.getElementById('password')
        );
      });

    })();
  </script>

</body>
</html>