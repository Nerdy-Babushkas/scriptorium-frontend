<!-- views/pages/search-results.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Search Results - Scriptorium' }) %>
    <style>
        /* Base Theme Colors matching your screenshots */
        .bg-scriptorium-dark { background-color: #0f3d3e; background: radial-gradient(circle at 50% 0%, #0f4c75 0%, #05181c 100%); }
        .text-teal-neon { color: #00C49A; }
        .bg-teal-neon { background-color: #00C49A; }
        .border-teal-neon { border-color: #00C49A; }
        
        /* Glassmorphism Card Style */
        .glass-card {
            background-color: rgba(20, 30, 35, 0.6);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }
        
        /* Crisp Input Fields */
        .crisp-input {
            background-color: white;
            color: #1a1a1a;
            border-radius: 9999px; /* Pill shape */
            padding: 0.75rem 1.5rem;
            border: none;
            width: 100%;
            font-family: 'Outfit', sans-serif;
            font-weight: 500;
        }
        .crisp-input::placeholder { color: #888; }
        .crisp-input:focus { outline: 2px solid #00C49A; }
        
        /* Filter Tags */
        .filter-tag {
            background-color: #fff;
            color: #333;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
    </style>
</head>
<body class="bg-scriptorium-dark min-h-screen relative overflow-x-hidden font-outfit text-white">

    <%- include('../partials/background_blobs') %>
    <%- include('../partials/navbar_app') %>

    <main class="relative z-10 pt-8 pb-20 px-6">
        <div class="container mx-auto max-w-7xl">
            
            <div class="flex flex-col md:flex-row justify-between items-end mb-8 border-b border-white/10 pb-6">
                <div class="space-y-4">
                    <h1 class="text-4xl font-bold text-white tracking-tight">
                        Results for "<span id="queryDisplay" class="text-[#00C49A]">...</span>"
                    </h1>
                    
                    <div class="flex bg-black/30 rounded-full p-1 w-max border border-white/10">
                        <button class="px-6 py-1.5 rounded-full bg-[#00C49A]/20 text-[#00C49A] border border-[#00C49A] font-medium text-sm transition-all shadow-[0_0_10px_rgba(0,196,154,0.2)]">
                            Books
                        </button>
                        <button class="px-6 py-1.5 rounded-full text-white/50 hover:text-white border border-transparent font-medium text-sm transition-all cursor-not-allowed">
                            Music
                        </button>
                        <button class="px-6 py-1.5 rounded-full text-white/50 hover:text-white border border-transparent font-medium text-sm transition-all cursor-not-allowed">
                            Movies
                        </button>
                    </div>
                </div>

                <button id="toggleFilters" class="group flex items-center gap-2 px-5 py-2 rounded-full border border-[#00C49A]/50 text-[#00C49A] hover:bg-[#00C49A]/10 hover:border-[#00C49A] transition-all font-medium text-sm">
                    <span>Advanced Filters</span>
                    <svg id="chevronIcon" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
            </div>

            <div id="filterPanel" class="hidden mb-12 p-8 glass-card rounded-3xl relative animate-fade-in-down border-[#00C49A]/20">
                <h3 class="text-white font-bold mb-6 text-lg">Advanced Filters</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Genre</label>
                        <div class="relative">
                            <input type="text" id="filterGenre" placeholder="e.g. Fiction, Drama, Mystique" class="crisp-input">
                            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 hidden clear-btn">✕</button>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Author / Director</label>
                        <div class="relative">
                            <input type="text" id="filterAuthor" placeholder="Enter name" class="crisp-input">
                            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 hidden clear-btn">✕</button>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Year From</label>
                        <input type="number" id="filterYearFrom" placeholder="e.g., 1990" class="crisp-input">
                    </div>

                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Year To</label>
                        <input type="number" id="filterYearTo" placeholder="e.g., 2024" class="crisp-input">
                    </div>
                </div>

                <div class="mt-8 flex justify-end">
                    <button id="applyFilters" class="px-8 py-3 bg-[#00C49A] text-[#05181c] rounded-full font-bold shadow-lg hover:shadow-[0_0_20px_rgba(0,196,154,0.4)] hover:scale-105 transition-all">
                        Apply Filters
                    </button>
                </div>
            </div>

            <div id="loadingState" class="hidden flex flex-col items-center justify-center py-24">
                <div class="w-16 h-16 border-4 border-[#00C49A]/30 border-t-[#00C49A] rounded-full animate-spin mb-4"></div>
                <p class="text-[#00C49A] font-medium animate-pulse">Searching the archives...</p>
            </div>

            <div id="resultsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-8 pb-20">
                </div>

            <div id="emptyState" class="hidden text-center py-32 opacity-60">
                <img src="/assets/astro4.png" class="w-48 mx-auto mb-6 grayscale opacity-80" alt="No results">
                <p class="text-xl font-medium text-white/60">No books found matching your criteria.</p>
            </div>

            <div id="filterPanel" class="hidden mb-12 p-8 glass-card rounded-3xl relative animate-fade-in-down border-teal-neon/20">
                <h3 class="text-white font-bold mb-6 text-lg">Advanced Filters</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                    
                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Genre</label>
                        <div class="relative">
                            <input type="text" id="filterGenre" placeholder="e.g. Fiction, Drama, Mystique" class="crisp-input">
                            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 hidden clear-btn">✕</button>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Author / Director</label>
                        <div class="relative">
                            <input type="text" id="filterAuthor" placeholder="Enter name" class="crisp-input">
                            <button class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 hidden clear-btn">✕</button>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Year From</label>
                        <div class="relative">
                            <input type="number" id="filterYearFrom" placeholder="e.g., 1990" class="crisp-input">
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-white/70 text-sm font-medium ml-2">Year To</label>
                        <div class="relative">
                            <input type="number" id="filterYearTo" placeholder="e.g., 2024" class="crisp-input">
                        </div>
                    </div>

                </div>

                <div class="mt-8 flex justify-end">
                    <button id="applyFilters" class="px-8 py-3 bg-teal-neon text-[#05181c] rounded-full font-bold shadow-lg hover:shadow-[0_0_20px_rgba(0,196,154,0.4)] hover:scale-105 transition-all">
                        Apply Filters
                    </button>
                </div>
            </div>

            <div id="loadingState" class="hidden flex flex-col items-center justify-center py-24">
                <div class="w-16 h-16 border-4 border-teal-neon/30 border-t-teal-neon rounded-full animate-spin mb-4"></div>
                <p class="text-teal-neon font-medium animate-pulse">Searching the archives...</p>
            </div>

            <div id="resultsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-8">
                </div>

            <div id="emptyState" class="hidden text-center py-32 opacity-60">
                <img src="/assets/astro4.png" class="w-48 mx-auto mb-6 grayscale opacity-80" alt="No results">
                <p class="text-xl font-medium text-white/60">No books found matching your criteria.</p>
            </div>

        </div>
    </main>

<div id="shelfModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4 animate-fade-in">
        <div class="w-full max-w-md bg-[#0f191e] border border-[#00C49A]/30 rounded-3xl p-8 shadow-2xl relative">
            
            <div class="text-center mb-8">
                <h3 class="font-dancing text-4xl text-white mb-2">Add to Library</h3>
                <p class="text-white/50 text-sm">Select a shelf for <span id="modalBookTitle" class="text-[#00C49A] font-bold">this book</span></p>
            </div>

            <div class="space-y-3">
                <button class="shelf-btn w-full p-4 rounded-xl bg-white/5 border border-white/5 hover:border-[#00C49A] hover:bg-[#00C49A]/10 transition-all flex items-center justify-between group" data-shelf="favorites">
                    <div class="flex items-center gap-4">
                        <span class="text-2xl group-hover:scale-110 transition-transform">⭐</span>
                        <span class="font-bold text-white group-hover:text-[#00C49A]">Favorites</span>
                    </div>
                    <svg class="w-5 h-5 text-[#00C49A] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>

                <button class="shelf-btn w-full p-4 rounded-xl bg-white/5 border border-white/5 hover:border-[#00C49A] hover:bg-[#00C49A]/10 transition-all flex items-center justify-between group" data-shelf="wishlist">
                    <div class="flex items-center gap-4">
                        <span class="text-2xl group-hover:scale-110 transition-transform">🔖</span>
                        <span class="font-bold text-white group-hover:text-[#00C49A]">Wishlist</span>
                    </div>
                    <svg class="w-5 h-5 text-[#00C49A] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>

                <button class="shelf-btn w-full p-4 rounded-xl bg-white/5 border border-white/5 hover:border-[#00C49A] hover:bg-[#00C49A]/10 transition-all flex items-center justify-between group" data-shelf="reading">
                    <div class="flex items-center gap-4">
                        <span class="text-2xl group-hover:scale-110 transition-transform">📖</span>
                        <span class="font-bold text-white group-hover:text-[#00C49A]">Currently Reading</span>
                    </div>
                    <svg class="w-5 h-5 text-[#00C49A] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>

                <button class="shelf-btn w-full p-4 rounded-xl bg-white/5 border border-white/5 hover:border-[#00C49A] hover:bg-[#00C49A]/10 transition-all flex items-center justify-between group" data-shelf="finished">
                    <div class="flex items-center gap-4">
                        <span class="text-2xl group-hover:scale-110 transition-transform">✅</span>
                        <span class="font-bold text-white group-hover:text-[#00C49A]">Finished</span>
                    </div>
                    <svg class="w-5 h-5 text-[#00C49A] opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>
            </div>

            <button id="closeModal" class="mt-8 w-full py-3 rounded-full bg-[#D90429] hover:bg-red-700 text-white font-bold tracking-widest text-sm transition-all uppercase shadow-lg shadow-red-900/50">
                Cancel
            </button>
        </div>
    </div>
    <div id="toast" class="fixed bottom-8 right-8 flex items-center gap-4 px-6 py-4 rounded-xl shadow-2xl transform translate-y-40 transition-transform duration-500 z-[100] border-l-4">
        <div id="toastIcon" class="text-2xl"></div>
        <div>
            <h4 id="toastTitle" class="font-bold text-lg"></h4>
            <p id="toastMessage" class="text-sm opacity-90"></p>
        </div>
    </div>

    <script src="/js/search_results.js"></script>

    <style>
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-down { animation: fadeInDown 0.3s ease-out forwards; }
    </style>
</body>
</html>