<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Reflection History - Scriptorium' }) %>
    <style>
        /* Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
        .custom-scroll::-webkit-scrollbar-thumb { background: #00C49A; border-radius: 4px; }

        /* Highlight selected reflection */
        .highlighted {
            border: 2px solid #00C49A;
            background-color: rgba(0, 196, 154, 0.1);
        }

        .animate-slide-up {
            animation: slideUp 0.4s ease-out forwards;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-[#2C1810] min-h-screen text-white font-outfit overflow-x-hidden">

    <%- include('../partials/navbar_app') %>

    <main class="container mx-auto px-4 py-8 max-w-6xl">
        <div class="text-center mb-8">
            <h1 class="font-dancing text-5xl text-white mb-2">All Reflections</h1>
            <p class="text-white/50 text-sm">Browse and revisit your thoughts</p>
        </div>

        <div id="loading" class="flex flex-col items-center justify-center text-white/30">
            <div class="w-8 h-8 border-2 border-[#00C49A] border-t-transparent rounded-full animate-spin mb-2"></div>
            Loading reflections...
        </div>

        <div id="historyContainer" class="space-y-4 custom-scroll hidden max-h-[70vh] overflow-y-auto">
            <!-- Reflections will be injected here -->
        </div>

        <div id="emptyHistory" class="hidden flex flex-col items-center justify-center text-white/30 text-center mt-12">
            <p>No reflections yet.</p>
            <p class="text-xs mt-1">Go back and add a reflection first.</p>
        </div>
    </main>

    <script src="/js/reflections-history.js"> </script>
</body>
</html>