<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Share Feedback — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/landing.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body class="page-body">

  <div class="grain" aria-hidden="true"></div>
  <div class="page-orb page-orb-1" aria-hidden="true"></div>
  <div class="page-orb page-orb-2" aria-hidden="true"></div>

  <%- include('../partials/navbar_public') %>

  <main class="page-main page-main--narrow">

    <!-- Header -->
    <div class="feedback-header">
      <div class="page-eyebrow">We're listening</div>
      <h1 class="page-h1" style="text-align:center;">Share Your <span class="caveat">Thoughts</span></h1>
      <p class="page-sub" style="text-align:center; margin: 0 auto;">
        Found a bug? Have a feature idea? Something feel off? We read every single
        submission and your feedback shapes the future of Scriptorium.
      </p>
    </div>

    <!-- Form card -->
    <div class="page-card">

      <div id="fb-success" class="form-msg form-msg--success" role="alert">
        🎉 Thank you! Your feedback has been sent. We really appreciate it.
      </div>

      <div id="fb-error" class="form-msg form-msg--error" role="alert">
        Something went wrong. Please try again.
      </div>

      <div class="feedback-form">

        <!-- Name -->
        <div class="form-field">
          <label class="form-label" for="fb-name">
            Your Name <span class="optional">(optional)</span>
          </label>
          <input id="fb-name" type="text" class="form-input" placeholder="e.g. Jane Doe" />
        </div>

        <!-- Email -->
        <div class="form-field">
          <label class="form-label" for="fb-email">
            Your Email <span class="optional">(optional — only if you want a reply)</span>
          </label>
          <input id="fb-email" type="email" class="form-input" placeholder="e.g. jane@example.com" />
        </div>

        <!-- Area -->
        <div class="form-field">
          <label class="form-label" for="fb-area">
            Area <span class="required">*</span>
          </label>
          <div class="form-select-wrap">
            <select id="fb-area" class="form-select">
              <option value="" disabled selected>Select an area…</option>
              <option value="General">General</option>
              <option value="Main Room (3D)">Main Room (3D)</option>
              <option value="Library">Library</option>
              <option value="Theatre">Theatre</option>
              <option value="Music Room">Music Room</option>
              <option value="Search">Search</option>
              <option value="Reflections">Reflections</option>
              <option value="Progress & Goals">Progress & Goals</option>
              <option value="Rewards">Rewards</option>
              <option value="Customise (Avatars)">Customise (Avatars)</option>
              <option value="Profile & Account">Profile & Account</option>
              <option value="Bug Report">🐛 Bug Report</option>
              <option value="Feature Request">✨ Feature Request</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <!-- Feedback -->
        <div class="form-field">
          <label class="form-label" for="fb-description">
            Your Feedback <span class="required">*</span>
          </label>
          <textarea
            id="fb-description"
            class="form-textarea"
            placeholder="Tell us what you think, what you'd love to see, or what's not working for you…"
          ></textarea>
          <div id="fb-inline-error" class="form-msg form-msg--error" role="alert">
            Please fill in the required fields (area and feedback).
          </div>
        </div>

        <!-- Submit -->
        <button id="fb-submit" class="btn-submit" onclick="submitFeedback()">
          Send Feedback
        </button>

        <p class="form-footer-note">
          You can also reach us at
          <a href="mailto:babushkas.prj@gmail.com">babushkas.prj@gmail.com</a>
        </p>

      </div>
    </div>

    <!-- Back link -->
    <div style="text-align:center; margin-top: 2rem;">
      <a href="/contact" class="btn-back" style="display:inline-flex;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 5l-7 7 7 7"/>
        </svg>
        Back to Contact
      </a>
    </div>

  </main>

  <script src="/js/feedback.js"></script>

</body>
</html>
