<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head_public', { title: 'Page Not Found - Scriptorium' }) %>
</head>
<body class="bg-scriptorium-dark min-h-screen relative overflow-x-hidden font-outfit text-white flex flex-col">

    <%- include('../partials/background_blobs') %>

    <% if (typeof user !== 'undefined' && user) { %>
        <%- include('../partials/navbar_app') %>
    <% } else { %>
        <%- include('../partials/navbar_public') %>
    <% } %>

    <main class="flex-grow flex items-center justify-center relative z-10 pt-20 pb-12 px-6">
        <div class="container mx-auto max-w-6xl"> 
            
            <div class="grid lg:grid-cols-2 gap-8 items-center">
                
                <div class="order-2 lg:order-1 text-center lg:text-left space-y-6">
                    <h1 class="font-dancing text-6xl sm:text-8xl font-bold text-[#06D6A0] leading-none">
                        404
                    </h1>

                    <h2 class="font-outfit text-3xl sm:text-4xl font-bold">
                        This chapter hasn't been written yet.
                    </h2>
                    
                    <p class="font-roboto text-xl text-gray-300 max-w-md mx-auto lg:mx-0">
                        Oops! The page you are looking for seems to have gotten lost in the archives of the Scriptorium.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-4">
                        <% if (typeof user !== 'undefined' && user) { %>
                            <a href="/room" 
                               class="px-8 py-3 rounded-[50px] bg-[#06D6A0] hover:bg-[#00b885] text-white font-outfit text-lg font-bold uppercase tracking-widest transition-all shadow-lg transform hover:scale-105 text-center">
                                Back to Room
                            </a>
                        <% } else { %>
                            <a href="/" 
                               class="px-8 py-3 rounded-[50px] bg-[#06D6A0] hover:bg-[#00b885] text-white font-outfit text-lg font-bold uppercase tracking-widest transition-all shadow-lg transform hover:scale-105 text-center">
                                Go Home
                            </a>
                        <% } %>
                    </div>
                </div>

                <div class="order-1 lg:order-2 flex justify-center">
                    <%- include('../partials/floating_prop', { img: '/assets/astro4.png', alt: 'Rocket Launching' }) %>
                </div>

            </div>
        </div>
    </main>

</body>
</html>