<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head_public', { title: 'Sign Up - Scriptorium' }) %>
</head>
<body class="bg-scriptorium-dark min-h-screen relative overflow-x-hidden font-outfit text-white">

    <%- include('../partials/background_blobs') %>
    <%- include('../partials/navbar_public') %>

    <div class="relative z-10 pt-20 pb-4">
        <div class="container mx-auto px-6 lg:px-20">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                
                <div class="max-w-xl">
                    <h1 class="font-dancing text-[64px] font-bold text-white capitalize leading-[110%] mb-2">
                        Welcome!
                    </h1>

                    <p class="font-roboto text-2xl sm:text-[30px] text-white mb-4">
                        Create an account or
                        <a href="/login" class="font-bold underline decoration-white hover:text-scriptorium-green transition-colors">
                            log in
                        </a>
                    </p>

                    <form id="signupForm" class="space-y-2">
                        <div>
                            <label class="font-roboto text-lg font-bold text-white block mb-1">Email</label>
                            <input type="email" id="email" required class="w-full h-14 px-6 bg-transparent border border-[#118AB2] rounded-[50px] text-white placeholder-white/50 focus:outline-none focus:border-[#06D6A0] transition-colors shadow-sm" />
                        </div>

                        <div class="relative">
                            <label class="font-roboto text-lg font-bold text-white block mb-1">Password</label>

                            <input type="password"
                                id="password"
                                required
                                class="w-full h-14 px-6 pr-14 bg-transparent border border-[#118AB2] rounded-[50px] text-white placeholder-white/50 focus:outline-none focus:border-[#06D6A0] transition-colors shadow-sm" />

                            <button type="button"
                                id="togglePassword"
                                class="absolute right-5 top-[45px] text-white/70 hover:text-white">
                                👁
                            </button>
                        </div>

                        <div class="relative">
                            <label class="font-roboto text-lg font-bold text-white block mb-1">Confirm Password</label>

                            <input type="password"
                                id="confirmPassword"
                                required
                                class="w-full h-14 px-6 pr-14 bg-transparent border border-[#118AB2] rounded-[50px] text-white placeholder-white/50 focus:outline-none focus:border-[#06D6A0] transition-colors shadow-sm" />

                            <button type="button"
                                id="toggleConfirmPassword"
                                class="absolute right-5 top-[45px] text-white/70 hover:text-white">
                                👁
                            </button>
                        </div>

                        <div id="formMessage" class="hidden mt-3 px-5 py-4 rounded-2xl border text-lg font-medium transition-all"></div>

                        <button type="submit" id="submitBtn" class="w-full h-14 bg-[#06D6A0] hover:bg-[#00b885] transition-colors rounded-[50px] font-outfit text-xl font-semibold text-white uppercase tracking-[2px] mt-4 shadow-lg transform hover:scale-[1.02]">
                            Sign up
                        </button>

                        <div class="mt-3 rounded-2xl p-5" style="background:rgba(0,0,0,0.45);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.08);">
                            <p class="font-roboto text-white/50 text-xs uppercase tracking-widest text-center mb-4">What's waiting for you</p>
                            <div class="space-y-3">
                                <div class="flex items-center gap-3">
                                    <span class="text-base w-6 text-center flex-shrink-0">🏠</span>
                                    <p class="font-roboto text-white/80 text-sm">Your own cosy 3D room to explore and decorate</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-base w-6 text-center flex-shrink-0">📚</span>
                                    <p class="font-roboto text-white/80 text-sm">Track books, films, music and podcasts in one place</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-base w-6 text-center flex-shrink-0">✍️</span>
                                    <p class="font-roboto text-white/80 text-sm">Write reflections and build a personal reading journal</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="text-base w-6 text-center flex-shrink-0">🧶</span>
                                    <p class="font-roboto text-white/80 text-sm">Earn yarns, unlock avatars and customise your space</p>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="hidden lg:flex items-center justify-center">
                    <img src="/assets/netflix.png" alt="Hands holding tablet" class="w-full max-w-[615px] h-auto drop-shadow-2xl" />
                </div>

            </div>
        </div>
    </div>

    <script src="/js/signup.js"></script>
</body>
</html>