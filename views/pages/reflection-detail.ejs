<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Reflection Detail - Scriptorium' }) %>
    <style>
        /* Mood buttons — identical to add-reflection */
        .mood-btn {
            transition: all 0.2s ease;
        }
        .mood-btn.selected {
            background-color: #00C49A;
            color: #000;
            border-color: #00C49A;
            box-shadow: 0 0 15px rgba(0, 196, 154, 0.4);
        }

        /* Custom confirm modal */
        #confirmModal {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }
        #confirmModal.open {
            opacity: 1;
            pointer-events: all;
        }
        #confirmBox {
            transform: scale(0.95) translateY(8px);
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        #confirmModal.open #confirmBox {
            transform: scale(1) translateY(0);
        }
    </style>
</head>
<body class="bg-[#2C1810] min-h-screen font-outfit text-white flex flex-col">

    <%- include('../partials/navbar_app') %>

    <main class="flex-grow flex justify-center items-start px-4 py-12">
        <div id="loading" class="flex flex-col items-center justify-center text-white/30">
            <div class="w-10 h-10 border-4 border-[#00C49A] border-t-transparent rounded-full animate-spin mb-3"></div>
            Loading reflection...
        </div>

        <div id="reflectionContainer" class="hidden w-full max-w-5xl bg-[#1a262d]/80 backdrop-blur-xl border border-white/10 rounded-3xl p-8 flex flex-col gap-6 shadow-2xl">

            <!-- Top section: image + title + metadata -->
            <div class="flex flex-col md:flex-row gap-6">
                <!-- Image -->
                <div class="flex-shrink-0 w-full md:w-1/3 h-64 md:h-80 overflow-hidden rounded-lg border border-white/10 bg-black/40">
                    <img id="itemImage" class="w-full h-full object-cover rounded-lg">
                </div>

                <!-- Text info -->
                <div class="flex-grow flex flex-col gap-3">
                    <h2 id="itemTitle" class="text-3xl md:text-4xl font-bold text-[#00C49A] truncate"></h2>
                    <span id="itemDate" class="text-white/40 text-sm md:text-base"></span>

                    <!-- VIEW: mood tags (read-only) -->
                    <div id="moodTags" class="flex flex-wrap gap-2 mt-2"></div>

                    <!-- EDIT: mood buttons (hidden until editing) -->
                    <div id="moodEditor" class="hidden flex flex-col gap-2 mt-2">
                        <label class="text-[#00C49A] text-xs font-bold uppercase tracking-wider">Mood (pick up to 3)</label>
                        <div class="flex flex-wrap gap-3" id="moodBtnContainer">
                            <button type="button" class="mood-btn px-4 py-2 rounded-full border border-white/10 hover:border-[#00C49A] transition-all text-sm flex items-center gap-2" data-mood="Happy">
                                <span>😊</span> Happy
                            </button>
                            <button type="button" class="mood-btn px-4 py-2 rounded-full border border-white/10 hover:border-[#00C49A] transition-all text-sm flex items-center gap-2" data-mood="Thoughtful">
                                <span>🤔</span> Thoughtful
                            </button>
                            <button type="button" class="mood-btn px-4 py-2 rounded-full border border-white/10 hover:border-[#00C49A] transition-all text-sm flex items-center gap-2" data-mood="Inspired">
                                <span>✨</span> Inspired
                            </button>
                            <button type="button" class="mood-btn px-4 py-2 rounded-full border border-white/10 hover:border-[#00C49A] transition-all text-sm flex items-center gap-2" data-mood="Confused">
                                <span>😵‍💫</span> Confused
                            </button>
                            <button type="button" class="mood-btn px-4 py-2 rounded-full border border-white/10 hover:border-[#00C49A] transition-all text-sm flex items-center gap-2" data-mood="Sad">
                                <span>😢</span> Sad
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reflection text (view) / textarea (edit) -->
            <div id="reflectionBody">
                <p id="reflectionText" class="text-white/80 text-lg md:text-xl font-light whitespace-pre-line leading-relaxed"></p>
            </div>

            <!-- Buttons -->
            <div class="mt-6 flex flex-col md:flex-row md:justify-between items-start md:items-center gap-4">
                <button id="backBtn" class="px-6 py-2 rounded-full border border-white/10 text-white/80 hover:text-white hover:bg-white/5 transition-all">
                    ← Back
                </button>

                <div class="flex gap-4" id="reflectionActions">
                    <!-- View mode -->
                    <button id="editBtn" class="px-4 py-2 rounded-full border border-white/10 text-white/80 hover:text-white hover:bg-white/5 transition-all">
                        ✏️ Edit
                    </button>
                    <button id="deleteBtn" class="px-4 py-2 rounded-full border border-red-500 text-red-500/70 hover:text-red-500 hover:bg-red-500/10 transition-all">
                        🗑️ Delete
                    </button>

                    <!-- Edit mode (hidden by default) -->
                    <button id="saveEditBtn" class="hidden px-4 py-2 rounded-full bg-[#00C49A] text-black font-bold hover:bg-white hover:scale-105 transition-all shadow-[0_0_20px_rgba(0,196,154,0.3)]">
                        💾 Save
                    </button>
                    <button id="cancelEditBtn" class="hidden px-4 py-2 rounded-full border border-white/10 text-white/60 hover:text-white hover:bg-white/5 transition-all">
                        ❌ Cancel
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-8 right-8 flex items-center gap-4 px-6 py-4 rounded-xl shadow-2xl transform translate-y-40 transition-transform duration-500 z-[100] border-l-4">
        <div id="toastIcon" class="text-2xl"></div>
        <div>
            <h4 id="toastTitle" class="font-bold text-lg"></h4>
            <p id="toastMessage" class="text-sm opacity-90"></p>
        </div>
    </div>

    <!-- Custom Confirm Modal -->
    <div id="confirmModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[200] flex items-center justify-center px-4">
        <div id="confirmBox" class="w-full max-w-sm bg-[#0f191e] border border-white/10 rounded-2xl p-6 flex flex-col gap-5 shadow-2xl">
            <div class="flex flex-col gap-1">
                <h3 id="confirmTitle" class="text-white font-bold text-lg"></h3>
                <p id="confirmMessage" class="text-white/50 text-sm"></p>
            </div>
            <div class="flex gap-3 justify-end">
                <button id="confirmCancel" class="px-5 py-2 rounded-full border border-white/10 text-white/60 hover:text-white hover:bg-white/5 transition-all text-sm font-semibold">
                    Cancel
                </button>
                <button id="confirmOk" class="px-5 py-2 rounded-full text-sm font-bold transition-all">
                    Confirm
                </button>
            </div>
        </div>
    </div>

    <script>
        // Pass the EJS-rendered reflectionId to the external JS safely
        window.__REFLECTION_ID__ = "<%= reflectionId %>";
    </script>
    <script src="/js/reflection-detail.js"></script>
</body>
</html>