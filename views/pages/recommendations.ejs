<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/recommendations.css">
</head>

<%# ── SHELF MODAL ────────────────────────────────────────────── %>
<div id="shelfModal">
  <div class="shelf-modal-box">
    <span class="shelf-modal-eyebrow">✦ Add to library</span>
    <p id="modalTitle">Title</p>

    <div class="shelf-options" id="shelfOptions-movies">
      <button class="shelf-option" data-shelf="favorites">
        <span class="shelf-icon">⭐</span>
        <span>
          <span class="shelf-label">Favorites</span>
          <span class="shelf-desc">All-time greats</span>
        </span>
      </button>
      <button class="shelf-option" data-shelf="watchlist">
        <span class="shelf-icon">📺</span>
        <span>
          <span class="shelf-label">Watchlist</span>
          <span class="shelf-desc">Watch later</span>
        </span>
      </button>
      <button class="shelf-option" data-shelf="watched">
        <span class="shelf-icon">👁</span>
        <span>
          <span class="shelf-label">Seen It</span>
          <span class="shelf-desc">Already watched</span>
        </span>
      </button>
    </div>

    <div class="shelf-options" id="shelfOptions-music" style="display:none;">
      <button class="shelf-option" data-shelf="favorites">
        <span class="shelf-icon">⭐</span>
        <span>
          <span class="shelf-label">Favorites</span>
          <span class="shelf-desc">All-time greats</span>
        </span>
      </button>
      <button class="shelf-option" data-shelf="listening">
        <span class="shelf-icon">🎧</span>
        <span>
          <span class="shelf-label">Listening</span>
          <span class="shelf-desc">On rotation</span>
        </span>
      </button>
    </div>

    <div class="shelf-options" id="shelfOptions-books" style="display:none;">
      <button class="shelf-option" data-shelf="favorites">
        <span class="shelf-icon">⭐</span>
        <span>
          <span class="shelf-label">Favorites</span>
          <span class="shelf-desc">All-time greats</span>
        </span>
      </button>
      <button class="shelf-option" data-shelf="reading">
        <span class="shelf-icon">📖</span>
        <span>
          <span class="shelf-label">Reading</span>
          <span class="shelf-desc">Currently reading</span>
        </span>
      </button>
      <button class="shelf-option" data-shelf="wishlist">
        <span class="shelf-icon">🔖</span>
        <span>
          <span class="shelf-label">Wishlist</span>
          <span class="shelf-desc">Want to read</span>
        </span>
      </button>
      <button class="shelf-option" data-shelf="finished">
        <span class="shelf-icon">📚</span>
        <span>
          <span class="shelf-label">Finished</span>
          <span class="shelf-desc">Already read</span>
        </span>
      </button>
    </div>

    <div class="shelf-divider"></div>
    <button id="closeShelfModal">Cancel</button>
  </div>
</div>

<%# ── TOAST ──────────────────────────────────────────────────── %>
<div id="toast">
  <div>
    <div id="toastTitle"></div>
    <div id="toastMessage"></div>
  </div>
</div>

<body class="recs-body">

  <%# Grain overlay — same as landing %>
  <div class="grain" aria-hidden="true"></div>

  <%# Custom cursor — JS drives translate3d %>
  <div class="cursor" aria-hidden="true"></div>

  <%# Ambient orbs %>
  <div class="bg-orb bg-orb-1" aria-hidden="true"></div>
  <div class="bg-orb bg-orb-2" aria-hidden="true"></div>

  <main class="recs-main" style="padding-top:1.5rem;">

    <%# ── PAGE CONTROLS ────────────────────────────────────────── %>
    <div class="page-controls">
      <div class="page-controls-left">
        <a href="/room" class="btn-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Back to Room
        </a>
        <div style="display:flex; flex-direction:column; gap:5px;">
          <h1 id="pageTitle">AI Recommendations</h1>
          <span class="ai-badge">
            <span class="ai-badge-dot" aria-hidden="true"></span>
            Babushka AI · Personalised for you
          </span>
        </div>
      </div>

      <button class="btn-refresh" onclick="refreshActive()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
        </svg>
        New Picks
      </button>
    </div>

    <%# ── TABS ───────────────────────────────────────────────── %>
    <div class="tabs-bar" role="tablist">
      <button class="tab-btn active" data-tab="movies" onclick="switchTab('movies')"
              role="tab" aria-selected="true">
        <span class="tab-icon" aria-hidden="true">🎬</span> Movies
      </button>
      <button class="tab-btn" data-tab="music" onclick="switchTab('music')"
              role="tab" aria-selected="false">
        <span class="tab-icon" aria-hidden="true">🎵</span> Music
      </button>
      <button class="tab-btn" data-tab="books" onclick="switchTab('books')"
              role="tab" aria-selected="false">
        <span class="tab-icon" aria-hidden="true">📚</span> Books
      </button>
    </div>

    <%# ── TAB PANELS ─────────────────────────────────────────── %>
    <div class="tab-panel active" data-tab="movies" id="panel-movies" role="tabpanel">
      <div id="grid-movies"    style="display:grid; grid-template-columns:repeat(2,1fr); gap:1.25rem;"></div>
      <div id="empty-movies"   style="display:none;"></div>
      <div id="loading-movies" class="panel-loading">
        <div class="sheep-wrapper" aria-hidden="true">
          <img src="/assets/sheep-knitting.gif" class="sheep-img" alt="">
        </div>
        <p class="loading-text" id="loadingText-movies">
          Babushka AI is knitting your recommendations<span class="dots" aria-hidden="true"></span>
        </p>
      </div>
    </div>

    <div class="tab-panel" data-tab="music" id="panel-music" role="tabpanel">
      <div id="grid-music"    style="display:grid; grid-template-columns:repeat(2,1fr); gap:1.25rem;"></div>
      <div id="empty-music"   style="display:none;"></div>
      <div id="loading-music" class="panel-loading">
        <div class="sheep-wrapper" aria-hidden="true">
          <img src="/assets/sheep-knitting.gif" class="sheep-img" alt="">
        </div>
        <p class="loading-text" id="loadingText-music">
          Babushka AI is curating your soundtrack<span class="dots" aria-hidden="true"></span>
        </p>
      </div>
    </div>

    <div class="tab-panel" data-tab="books" id="panel-books" role="tabpanel">
      <div id="grid-books"    style="display:grid; grid-template-columns:repeat(2,1fr); gap:1.25rem;"></div>
      <div id="empty-books"   style="display:none;"></div>
      <div id="loading-books" class="panel-loading">
        <div class="sheep-wrapper" aria-hidden="true">
          <img src="/assets/sheep-knitting.gif" class="sheep-img" alt="">
        </div>
        <p class="loading-text" id="loadingText-books">
          Babushka AI is flipping through the shelves<span class="dots" aria-hidden="true"></span>
        </p>
      </div>
    </div>

  </main>

  <script src="/js/recommendations.js"></script>

  <script>
    /* ── Cursor ─────────────────────────────────────────────────
       JS drives translate3d(x,y,0). CSS handles ONLY size/colour.
       We also re-bind dynamically injected cards so hover works.
    ────────────────────────────────────────────────────────────── */
    (function () {
      var cursor = document.querySelector('.cursor');
      if (!cursor) return;

      document.addEventListener('mousemove', function (e) {
        cursor.style.transform = 'translate3d(' + e.clientX + 'px,' + e.clientY + 'px,0) translate(-50%,-50%)';
      });

      function bindHover() {
        document.querySelectorAll('a,button,[role="button"]').forEach(function (el) {
          if (el._cursorBound) return;
          el._cursorBound = true;
          el.addEventListener('mouseenter', function () { cursor.classList.add('hov'); });
          el.addEventListener('mouseleave', function () { cursor.classList.remove('hov'); });
        });
      }

      bindHover();

      /* Re-bind whenever the grids are populated by recommendations.js */
      var observer = new MutationObserver(bindHover);
      ['grid-movies', 'grid-music', 'grid-books'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) observer.observe(el, { childList: true });
      });

      document.addEventListener('mousedown', function () { cursor.classList.add('clicking'); });
      document.addEventListener('mouseup',   function () { cursor.classList.remove('clicking'); });
    }());
  </script>
</body>
</html>
