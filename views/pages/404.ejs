<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Page Not Found — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body class="page-body">

  <div class="grain" aria-hidden="true"></div>
  <div class="page-orb page-orb-1" aria-hidden="true"></div>
  <div class="page-orb page-orb-2" aria-hidden="true"></div>

  <% if (typeof user !== 'undefined' && user) { %>
    <%- include('../partials/navbar_app') %>
  <% } else { %>
    <%- include('../partials/navbar_public') %>
  <% } %>

  <main class="page-main page-main--wide">
    <div class="not-found">

      <!-- Left: text -->
      <div>
        <div class="page-eyebrow">Lost in the archives</div>
        <div class="not-found-number">
          4<span class="zero">0</span>4
        </div>
        <h1 class="not-found-tagline">This chapter hasn't been written yet.</h1>
        <p class="not-found-body">
          The page you're looking for seems to have gotten lost somewhere deep
          in the Scriptorium archives. It might have moved, or perhaps it never existed.
        </p>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/room" class="btn-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Back to Room
          </a>
        <% } else { %>
          <a href="/" class="btn-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
            Go Home
          </a>
        <% } %>
      </div>

      <!-- Right: illustration -->
      <div class="not-found-img">
        <img src="/assets/astro4.png" alt="Floating astronaut" />
      </div>

    </div>
  </main>

</body>
</html>
