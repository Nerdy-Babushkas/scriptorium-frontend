<!--views/pages/progress.ejs-->
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Progress - Scriptorium' }) %>
    <style>
        #container3d { width: 100vw; height: 100vh; display: block; }



    /* ============================================================
       PROGRESS PAGE
    ============================================================ */

    .bg-orb {
        position: fixed; border-radius: 50%;
        filter: blur(90px); pointer-events: none;
        z-index: 0; opacity: 0.18;
        animation: orbDrift 12s ease-in-out infinite alternate;
    }
    .bg-orb-1 { width:520px; height:520px; background:#1a0f4c; top:-120px; left:-100px; }
    .bg-orb-2 { width:400px; height:400px; background:#00C49A; bottom:10%; right:-80px; animation-delay:-4s; }
    .bg-orb-3 { width:300px; height:300px; background:#4c1a0f; bottom:30%; left:30%; animation-delay:-8s; }
    @keyframes orbDrift {
        from { transform: translateY(0px) scale(1); }
        to   { transform: translateY(30px) scale(1.08); }
    }

    .page-controls {
        display: flex; align-items: center;
        justify-content: space-between; flex-wrap: wrap;
        gap: 12px; margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .page-controls-left { display: flex; align-items: center; gap: 14px; }
    .btn-back {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 8px 16px; border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.7);
        font-size: 0.82rem; font-weight: 500; cursor: pointer;
        transition: background 0.2s, color 0.2s, transform 0.15s;
        text-decoration: none;
    }
    .btn-back:hover { background: rgba(255,255,255,0.1); color:#fff; transform: translateX(-2px); }
    .btn-back svg { width:14px; height:14px; flex-shrink:0; }

    .section-title {
        font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em;
        text-transform: uppercase; color: #00C49A;
        margin: 0 0 1rem; display: flex; align-items: center; gap: 8px;
    }
    .section-title::after {
        content: ''; flex: 1; height: 1px;
        background: linear-gradient(90deg, rgba(0,196,154,0.3), transparent);
    }

    /* ── Filter pills ── */
    .filter-bar {
        display: flex;
        background: rgba(0,0,0,0.3);
        border-radius: 999px;
        padding: 3px;
        border: 1px solid rgba(255,255,255,0.08);
        width: fit-content;
        margin-bottom: 1.5rem;
    }
    .filter-pill {
        padding: 7px 20px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        color: rgba(255,255,255,0.4);
        transition: all 0.2s;
    }
    .filter-pill:hover { color: rgba(255,255,255,0.7); }
    .filter-pill.active {
        background: rgba(0,196,154,0.15);
        border-color: rgba(0,196,154,0.4);
        color: #00C49A;
    }

    /* ── Stats bar ── */
    .stats-card {
        background: rgba(15,25,30,0.7);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px; padding: 22px 28px;
        margin-bottom: 2rem;
        display: flex; align-items: center; gap: 28px;
        flex-wrap: wrap;
        position: relative; overflow: hidden;
    }
    .stats-card::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at 0% 0%, rgba(0,196,154,0.06) 0%, transparent 60%);
        pointer-events: none;
    }
    .stat-block { display: flex; flex-direction: column; gap: 2px; }
    .stat-value {
        font-size: 1.6rem; font-weight: 800; line-height: 1;
        background: linear-gradient(135deg, #00C49A, #00a07d);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .stat-label {
        font-size: 0.62rem; color: rgba(255,255,255,0.35);
        font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em;
    }
    .stat-divider {
        width: 1px; height: 36px;
        background: rgba(255,255,255,0.08);
    }

    /* ── Goal cards ── */
    .goal-list {
        display: flex; flex-direction: column; gap: 12px;
        margin-bottom: 2rem;
    }
    .goal-card {
        background: rgba(15,25,30,0.65);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 18px; padding: 18px 20px;
        position: relative; overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
    }
    .goal-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255,255,255,0.15);
        box-shadow: 0 8px 28px rgba(0,0,0,0.4);
    }
    .goal-card.selected {
        border-color: rgba(0,196,154,0.4);
        box-shadow: 0 0 20px rgba(0,196,154,0.08);
    }
    .goal-card.completed-card {
        opacity: 0.7;
    }
    .goal-card.completed-card:hover { opacity: 0.85; }

    .goal-top { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
    .goal-icon {
        width: 38px; height: 38px; border-radius: 50%;
        background: rgba(0,196,154,0.12);
        border: 1px solid rgba(0,196,154,0.2);
        display: flex; align-items: center; justify-content: center;
        color: #00C49A; flex-shrink: 0;
    }
    .goal-meta { flex: 1; min-width: 0; }
    .goal-title {
        font-size: 0.9rem; font-weight: 700; color: #fff;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .goal-media-label {
        font-size: 0.7rem; font-weight: 600;
        color: #FFDA6D; margin-top: 2px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .goal-type-pill {
        font-size: 0.6rem; font-weight: 700; padding: 2px 8px;
        border-radius: 999px; text-transform: capitalize; letter-spacing: 0.04em;
        background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.4);
    }

    .goal-progress-row { display: flex; align-items: center; gap: 12px; }
    .goal-bar-track {
        flex: 1; height: 8px; border-radius: 999px;
        background: rgba(255,255,255,0.06);
        overflow: hidden;
    }
    .goal-bar-fill {
        height: 100%; border-radius: 999px;
        background: linear-gradient(90deg, #00C49A, #00a07d);
        transition: width 0.35s cubic-bezier(0.4,0,0.2,1);
    }
    .goal-bar-fill.complete {
        background: linear-gradient(90deg, #FFDA6D, #ffb300);
    }
    .goal-count {
        font-size: 0.78rem; font-weight: 700; color: rgba(255,255,255,0.7);
        min-width: 60px; text-align: right;
        white-space: nowrap;
    }

    /* Increment button */
    .goal-actions { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
    .btn-increment {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 14px; border-radius: 10px;
        font-size: 0.72rem; font-weight: 700; cursor: pointer;
        background: rgba(0,196,154,0.1);
        border: 1px solid rgba(0,196,154,0.25);
        color: #00C49A;
        transition: all 0.18s;
    }
    .btn-increment:hover { background: rgba(0,196,154,0.2); border-color: rgba(0,196,154,0.45); }
    .btn-increment:disabled { opacity: 0.35; cursor: not-allowed; }
    .btn-increment svg { width: 14px; height: 14px; }

    .btn-edit-goal {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 14px; border-radius: 10px;
        font-size: 0.72rem; font-weight: 700; cursor: pointer;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.5);
        transition: all 0.18s;
    }
    .btn-edit-goal:hover { background: rgba(255,255,255,0.08); color: #fff; }

    /* ── Empty state ── */
    .empty-state {
        text-align: center; padding: 48px 20px;
        color: rgba(255,255,255,0.3);
    }
    .empty-state-icon { font-size: 2.5rem; margin-bottom: 12px; }
    .empty-state-text { font-size: 0.88rem; font-weight: 500; }

    /* ── Bottom actions ── */
    .bottom-actions {
        display: flex; gap: 10px; flex-wrap: wrap;
    }
    .btn-add-goal {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 11px 24px; border-radius: 12px;
        font-size: 0.82rem; font-weight: 700; cursor: pointer;
        background: rgba(0,196,154,0.12);
        border: 1px solid rgba(0,196,154,0.3);
        color: #00C49A;
        transition: all 0.2s;
    }
    .btn-add-goal:hover { background: rgba(0,196,154,0.22); border-color: rgba(0,196,154,0.5); }
    .btn-delete-goal {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 11px 24px; border-radius: 12px;
        font-size: 0.82rem; font-weight: 700; cursor: pointer;
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.2);
        color: rgba(248,113,113,0.8);
        transition: all 0.2s;
    }
    .btn-delete-goal:hover { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.4); }

    /* ── Modal (shared) ── */
    .modal-overlay {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.85);
        display: none; align-items: center; justify-content: center;
        z-index: 9999; backdrop-filter: blur(8px);
        padding: 16px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
        background: #0a1418;
        border: 1px solid rgba(0,196,154,0.2);
        border-radius: 24px; padding: 32px 28px 24px;
        max-width: 420px; width: 100%;
        animation: modalPop 0.35s cubic-bezier(0.34,1.56,0.64,1);
        position: relative; overflow: hidden;
    }
    .modal-box::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at 50% -10%, rgba(0,196,154,0.06) 0%, transparent 65%);
        pointer-events: none;
    }
    @keyframes modalPop {
        from { transform: scale(0.8) translateY(20px); opacity: 0; }
        to   { transform: scale(1) translateY(0); opacity: 1; }
    }
    .modal-title {
        font-size: 1.15rem; font-weight: 800; color: #fff;
        margin: 0 0 20px;
    }
    .modal-field { margin-bottom: 14px; }
    .modal-label {
        display: block; font-size: 0.72rem; font-weight: 600;
        color: rgba(255,255,255,0.45); margin-bottom: 5px;
        text-transform: uppercase; letter-spacing: 0.06em;
    }
    .modal-input {
        width: 100%; padding: 10px 14px; border-radius: 12px;
        background: rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff; font-size: 0.85rem; font-weight: 500;
        outline: none; transition: border-color 0.2s;
        font-family: 'Outfit', sans-serif;
        box-sizing: border-box;
    }
    .modal-input:focus { border-color: rgba(0,196,154,0.5); }
    .modal-input::placeholder { color: rgba(255,255,255,0.2); }
    .modal-btns { display: flex; gap: 10px; margin-top: 22px; }
    .modal-btn {
        flex: 1; padding: 11px; border-radius: 12px;
        font-size: 0.82rem; font-weight: 700; cursor: pointer;
        transition: all 0.18s;
    }
    .modal-btn-cancel {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.5);
    }
    .modal-btn-cancel:hover { background: rgba(255,255,255,0.06); }
    .modal-btn-save {
        background: rgba(0,196,154,0.15);
        border: 1px solid rgba(0,196,154,0.35);
        color: #00C49A;
    }
    .modal-btn-save:hover { background: rgba(0,196,154,0.25); }

    /* Media search dropdown */
    .media-results {
        position: absolute; z-index: 50;
        margin-top: 4px; width: 100%;
        max-height: 200px; overflow-y: auto;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.1);
        background: #081014;
        box-shadow: 0 12px 40px rgba(0,0,0,0.6);
    }
    .media-results.hidden { display: none; }
    .media-result-row {
        width: 100%; padding: 10px 14px;
        text-align: left; cursor: pointer;
        border: none; background: none;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background 0.15s;
        display: block;
    }
    .media-result-row:hover { background: rgba(0,196,154,0.08); }
    .media-result-title { font-size: 0.82rem; font-weight: 600; color: #fff; }
    .media-result-sub { font-size: 0.7rem; color: rgba(0,196,154,0.7); }

    /* ── Celebration modal ── */
    .celebrate-icon { font-size: 3rem; margin-bottom: 12px; text-align: center; }
    .celebrate-title { font-size: 1.2rem; font-weight: 800; color: #fff; margin: 0 0 8px; text-align: center; }
    .celebrate-desc { font-size: 0.82rem; color: rgba(255,255,255,0.45); margin: 0 0 20px; text-align: center; line-height: 1.5; }
    .btn-write-reflection {
        display: flex; align-items: center; justify-content: center; gap: 7px;
        width: 100%; padding: 12px; border-radius: 12px;
        font-size: 0.85rem; font-weight: 700; cursor: pointer;
        background: rgba(0,196,154,0.15);
        border: 1px solid rgba(0,196,154,0.35);
        color: #00C49A; margin-bottom: 8px;
        transition: all 0.18s; text-decoration: none;
    }
    .btn-write-reflection:hover { background: rgba(0,196,154,0.25); }
    .btn-dismiss {
        display: block; width: 100%; padding: 10px; border-radius: 12px;
        font-size: 0.78rem; font-weight: 600; cursor: pointer;
        background: transparent; border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.4); text-align: center;
        transition: all 0.18s;
    }
    .btn-dismiss:hover { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.6); }

    /* ── Toast ── */
    #toastStack {
        position: fixed; bottom: 1.5rem; right: 1.5rem;
        display: flex; flex-direction: column-reverse; gap: 10px;
        z-index: 10000; pointer-events: none;
        max-width: 300px; width: calc(100vw - 3rem);
    }
    .toast-item {
        display: flex; align-items: flex-start; gap: 11px;
        padding: 13px 15px;
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
        pointer-events: all; cursor: pointer;
        color: #fff;
        transform: translateX(110%); opacity: 0;
        transition: transform 0.38s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
    }
    .toast-item.toast-success { background: #0a1a14; border-left: 3px solid #00C49A; }
    .toast-item.toast-error   { background: #1a0a0a; border-left: 3px solid #ef4444; }
    .toast-item.visible { transform: translateX(0); opacity: 1; }
    .toast-msg { font-size: 0.82rem; font-weight: 600; }

    /* ── Skeleton ── */
    .skeleton {
        background: linear-gradient(90deg,
            rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.09) 50%,
            rgba(255,255,255,0.04) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite; border-radius: 18px;
    }
    @keyframes shimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    @media (max-width: 640px) {
        .stats-card { gap: 16px; padding: 18px; }
        .stat-divider { display: none; }
    }
    </style>
</head>

<!-- Goal create/edit modal -->
<div class="modal-overlay" id="goalModal">
    <div class="modal-box">
        <h2 class="modal-title" id="modalHeading">Create a new goal</h2>
        <div class="modal-field">
            <label class="modal-label">Goal Name</label>
            <input type="text" id="modal-title" class="modal-input" placeholder="e.g. Read 5 chapters" />
        </div>
        <div class="modal-field">
            <label class="modal-label">Type</label>
            <select id="modal-type" class="modal-input">
                <option value="book">Book</option>
                <option value="music">Music</option>
                <option value="movies">Movies</option>
            </select>
        </div>
        <div class="modal-field">
            <label class="modal-label">Tracking</label>
            <select id="modal-tracking" class="modal-input">
                <option value="countable">Countable (Progress-based)</option>
                <option value="binary">One-time (Complete/Incomplete)</option>
                <option value="custom">Custom</option>
            </select>
        </div>
        <div class="modal-field" id="targetField">
            <label class="modal-label" id="target-label">Target Value</label>
            <input type="number" id="modal-target" class="modal-input" placeholder="Enter target value" />
        </div>
        <div class="modal-field" id="binaryField" style="display:none;">
            <label class="modal-label">Status</label>
            <select id="modal-current-binary" class="modal-input">
                <option value="0">Incomplete</option>
                <option value="1">Conquered</option>
            </select>
        </div>
        <div class="modal-field" style="position:relative;">
            <label class="modal-label">Attach media</label>
            <input type="text" id="modal-media-search" class="modal-input" placeholder="N/A" value="N/A" autocomplete="off" />
            <div id="media-search-results" class="media-results hidden"></div>
        </div>
        <div class="modal-btns">
            <button class="modal-btn modal-btn-cancel" id="modalCancel">Cancel</button>
            <button class="modal-btn modal-btn-save" id="modalSave">Save</button>
        </div>
    </div>
</div>

<!-- Celebration modal -->
<div class="modal-overlay" id="celebrateModal">
    <div class="modal-box" style="max-width:360px; text-align:center;">
        <div class="celebrate-icon">🎉</div>
        <p class="celebrate-title" id="celebrateTitle">Goal Complete!</p>
        <p class="celebrate-desc" id="celebrateDesc">Amazing work! How about capturing your thoughts with a reflection?</p>
        <a href="/add-reflection" class="btn-write-reflection">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
            Write a Reflection
        </a>
        <button class="btn-dismiss" id="celebrateDismiss">Maybe later</button>
    </div>
</div>

<!-- Toast stack -->
<div id="toastStack"></div>

<body style="background:radial-gradient(circle at 50% 0%, #1a0f4c 0%, #05181c 100%); background-color:#05181c;"
      class="min-h-screen relative overflow-x-hidden font-outfit text-white">

    <div class="bg-orb bg-orb-1"></div>
    <div class="bg-orb bg-orb-2"></div>
    <div class="bg-orb bg-orb-3"></div>

    <%- include('../partials/navbar_app') %>

    <main class="relative z-10 mt-6 px-4 md:px-8 max-w-[1100px] mx-auto pb-16">

        <%- include('../partials/room_nav') %>

        <!-- Page controls -->
        <div class="page-controls">
            <div class="page-controls-left">
                <a href="/room" class="btn-back">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 5l-7 7 7 7"/>
                    </svg>
                    Back to Room
                </a>
                <div style="display:flex;flex-direction:column;gap:5px;">
                    <h1 class="text-3xl font-dancing text-white" style="margin:0;">Progress</h1>
                    <span style="font-size:0.68rem;color:rgba(255,255,255,0.35);font-weight:500;letter-spacing:0.04em;">
                        Goals · Tracker
                    </span>
                </div>
            </div>
        </div>

        <!-- Stats overview -->
        <p class="section-title">Overview</p>
        <div class="stats-card">
            <div class="stat-block">
                <span class="stat-value" id="statActive">–</span>
                <span class="stat-label">Active</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-block">
                <span class="stat-value" id="statCompleted">–</span>
                <span class="stat-label">Completed</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-block">
                <span class="stat-value" id="statTotal">–</span>
                <span class="stat-label">Total</span>
            </div>
        </div>

        <!-- Filter -->
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:1.2rem;">
            <div class="filter-bar">
                <button class="filter-pill active" id="btn-active" data-filter="active">Active</button>
                <button class="filter-pill" id="btn-completed" data-filter="completed">Completed</button>
            </div>
        </div>

        <!-- Goal list -->
        <p class="section-title">Your goals</p>
        <div class="goal-list" id="goalsContainer">
            <% for(let i = 0; i < 4; i++) { %>
            <div class="skeleton" style="height:100px;"></div>
            <% } %>
        </div>

        <!-- Bottom actions -->
        <div class="bottom-actions">
            <button class="btn-add-goal" id="btnAddGoal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Add a Goal
            </button>
            <button class="btn-delete-goal" id="btnDeleteGoal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                Delete Selected
            </button>
        </div>

    </main>

    <script src="/js/progress.js"></script>
</body>
</html>