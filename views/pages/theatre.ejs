<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Theatre - Scriptorium' }) %>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
    <style>
        #container3d { width: 100%; height: 100vh; display: block; }
        @keyframes zoomIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        .animate-zoom-in { animation: zoomIn 0.3s ease-out forwards; }

        /* ── Penguin tip ── */
        #penguinTip { position:fixed; bottom:24px; left:24px; z-index:200; display:flex; align-items:flex-end; gap:10px; }
        #penguinTip.hidden { display:none; }
        #penguinBtn { width:56px; height:56px; border-radius:50%; border:none; background:transparent; cursor:pointer; padding:0; flex-shrink:0; position:relative; transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1); }
        #penguinBtn:hover { transform:scale(1.12) rotate(-6deg); }
        #penguinBtn img { width:100%; height:100%; object-fit:contain; }
        #penguinBtn::after { content:''; position:absolute; inset:-4px; border-radius:50%; border:2px solid rgba(255,218,109,0.5); animation:tipPulse 2.2s ease-in-out infinite; }
        #penguinBtn.open::after { display:none; }
        @keyframes tipPulse { 0%,100%{transform:scale(1);opacity:0.5;} 50%{transform:scale(1.2);opacity:0;} }
        #tipBubble { background:rgba(10,20,24,0.96); backdrop-filter:blur(16px); border:1px solid rgba(255,218,109,0.2); border-radius:18px; padding:16px 18px 14px; max-width:280px; width:calc(100vw - 110px); transform-origin:bottom left; animation:bubblePop 0.3s cubic-bezier(0.34,1.56,0.64,1); box-shadow:0 16px 48px rgba(0,0,0,0.6); }
        #tipBubble.hidden { display:none; }
        @keyframes bubblePop { from{transform:scale(0.85) translateY(10px);opacity:0;} to{transform:scale(1) translateY(0);opacity:1;} }
        .tip-step{display:none;} .tip-step.active{display:block;}
        .tip-eyebrow{font-size:0.57rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#FFDA6D;margin-bottom:5px;}
        .tip-title{font-size:0.9rem;font-weight:800;color:#fff;margin:0 0 5px;line-height:1.25;}
        .tip-body{font-size:0.75rem;color:rgba(255,255,255,0.58);line-height:1.5;margin:0 0 12px;}
        .tip-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;}
        .tip-dots{display:flex;gap:5px;}
        .tip-dot{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,0.18);transition:background 0.2s;}
        .tip-dot.active{background:#FFDA6D;}
        .tip-btn-row{display:flex;gap:7px;}
        .tip-btn{padding:6px 14px;border-radius:999px;font-size:0.72rem;font-weight:700;cursor:pointer;border:none;transition:all 0.18s;}
        .tip-btn-next{background:#FFDA6D;color:#1a0f0a;}
        .tip-btn-next:hover{background:#ffe89a;}
        .tip-btn-skip{background:transparent;color:rgba(255,255,255,0.28);border:1px solid rgba(255,255,255,0.1);}
        .tip-btn-skip:hover{color:rgba(255,255,255,0.55);}
    </style>
</head>
<body class="bg-[#0f0a1a] min-h-screen overflow-hidden font-outfit text-white">

    <%- include('../partials/navbar_app') %>

    <!-- 3D ROOM CONTAINER -->
    <div id="container3d"></div>

    <!-- BACK BUTTON -->
    <a href="/room" class="fixed top-20 left-4 z-20 flex items-center gap-2 px-4 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 transition-all">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-white"><path d="M19 12H5M12 19L5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="font-outfit text-sm font-medium text-white">Back to Room</span>
    </a>

    <!-- NAV BUTTONS -->
    <div class="fixed top-20 right-4 z-20 flex items-center gap-3">
        <a href="/music" class="px-5 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 transition-all">
            <span class="font-outfit text-sm font-medium text-white">Music Room</span>
        </a>
        <a href="/library" class="px-5 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 transition-all">
            <span class="font-outfit text-sm font-medium text-white">Library</span>
        </a>
        <%- include('../partials/ai_button') %>
    </div>

    <!-- SHELF MODAL -->
    <div id="shelfViewModal" class="hidden fixed inset-0 z-50 bg-[#0f191e]/95 backdrop-blur-xl p-6 flex flex-col animate-zoom-in">
        <div class="flex justify-between items-center max-w-7xl mx-auto w-full border-b border-white/10 pb-6 shrink-0">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-[#00C49A]/20 rounded-xl border border-[#00C49A]">
                    <svg class="w-8 h-8 text-[#00C49A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"/>
                    </svg>
                </div>
                <div>
                    <h2 id="shelfTitle" class="text-4xl font-dancing text-white">Shelf Name</h2>
                    <p class="text-white/50 text-sm mt-1"><span id="bookCount">0</span> items stored here</p>
                </div>
            </div>
            <button onclick="closeShelf()" class="flex items-center gap-2 px-6 py-2 rounded-full border border-red-500/50 text-red-400 hover:bg-red-500 hover:text-white transition-all">
                <span class="font-bold text-sm uppercase tracking-wider">Close</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="flex-grow overflow-y-auto w-full max-w-7xl mx-auto pt-8 pb-20">
            <div id="shelfLoading" class="hidden text-center text-[#00C49A] py-20">Loading...</div>
            <div id="shelfGrid" class="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-8"></div>
            <div id="shelfEmpty" class="hidden text-center text-white/50 py-20">This shelf is empty.</div>
        </div>
    </div>

    <script>
        const searchForm = document.querySelector('form[action="/search"]');
        if (searchForm) {
            let typeInput = searchForm.querySelector('input[name="type"]');
            if (!typeInput) {
                typeInput = document.createElement('input');
                typeInput.type = 'hidden';
                typeInput.name = 'type';
                searchForm.appendChild(typeInput);
            }
            typeInput.value = 'movies';
        }
    </script>
    <script src="/js/library.js"></script>
    <script type="module" src="/js/theatre-3d.js"></script>

    <!-- Penguin tip guide -->
    <div id="penguinTip" class="hidden">
        <button id="penguinBtn" title="How this works">
            <img src="/assets/penguin.gif" alt="Guide" />
        </button>
        <div id="tipBubble" class="hidden">
            <div class="tip-step active" data-step="0">
                <p class="tip-eyebrow">✦ Step 1 of 2</p>
                <p class="tip-title">Movie posters and the TV 🎬</p>
                <p class="tip-body">The <strong style='color:#8b5cf6;'>posters on the walls</strong> are your Watchlist and Favourites. The <strong style='color:#8b5cf6;'>TV screen</strong> opens Currently Watching, and the film reel leads to your Watched History. Hover to see the glow.</p>
                <div class="tip-footer">
                    <div class="tip-dots"></div>
                    <div class="tip-btn-row">
                        <button class="tip-btn tip-btn-skip" id="tipSkip">Don't show again</button>
                        <button class="tip-btn tip-btn-next" id="tipNext">Next →</button>
                    </div>
                </div>
            </div>
            <div class="tip-step" data-step="1">
                <p class="tip-eyebrow">✦ Step 2 of 2</p>
                <p class="tip-title">Inside each shelf 📺</p>
                <p class="tip-body">Click any film to see your reflections on it. Use <strong style='color:#8b5cf6;'>Move</strong> to shift it between shelves, or <strong style='color:#8b5cf6;'>Mark as done</strong> to add it to your Watched archive.</p>
                <div class="tip-footer">
                    <div class="tip-dots"></div>
                    <div class="tip-btn-row">
                        <button class="tip-btn tip-btn-skip" id="tipSkip">Don't show again</button>
                        <button class="tip-btn tip-btn-next" id="tipNext">Got it! 🐧</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
    (function() {
      const TIP_ID = "theatre-guide";
      const TOTAL  = 2;
      const BASE   = "https://scriptorium-backend-six.vercel.app/api";
      const token  = localStorage.getItem("token");
      if (!token) return;

      let step = 0, open = false;

      const headers = { "Content-Type":"application/json", Authorization:"JWT "+token };

      fetch(BASE+"/user/tips", { headers })
        .then(r => r.ok ? r.json() : null)
        .then(d => {
          if (!d || d.tipsDisabled || d.seenTips.includes(TIP_ID)) return;
          const wrap = document.getElementById("penguinTip");
          if (!wrap) return;
          wrap.classList.remove("hidden");
          buildDots();
          setTimeout(openBubble, 2000);
          document.getElementById("penguinBtn").addEventListener("click", () => open ? closeBubble() : openBubble());
          document.getElementById("tipBubble").addEventListener("click", e => {
            if (e.target.id === "tipNext") handleNext();
            if (e.target.id === "tipSkip") handleSkip();
          });
        }).catch(() => {});

      function buildDots() {
        document.querySelectorAll(".tip-dots").forEach(c => {
          c.innerHTML = "";
          for (let i=0;i<TOTAL;i++) { const d=document.createElement("div"); d.className="tip-dot"+(i===0?" active":""); c.appendChild(d); }
        });
      }
      function updateDots() { document.querySelectorAll(".tip-dot").forEach((d,i) => d.classList.toggle("active", i===step)); }
      function showStep(n) { document.querySelectorAll(".tip-step").forEach(s=>s.classList.remove("active")); document.querySelector(`.tip-step[data-step="${n}"]`)?.classList.add("active"); updateDots(); }
      function openBubble() { open=true; document.getElementById("tipBubble").classList.remove("hidden"); document.getElementById("penguinBtn").classList.add("open"); showStep(step); }
      function closeBubble() { open=false; document.getElementById("tipBubble").classList.add("hidden"); document.getElementById("penguinBtn").classList.remove("open"); }
      function handleNext() { if (step<TOTAL-1) { step++; showStep(step); } else dismiss(); }
      function handleSkip() { fetch(BASE+"/user/tips/disable",{method:"POST",headers,body:JSON.stringify({disabled:true})}).catch(()=>{}); dismiss(); }
      function dismiss() { closeBubble(); document.getElementById("penguinTip").classList.add("hidden"); fetch(BASE+"/user/tips/seen",{method:"POST",headers,body:JSON.stringify({tipId:TIP_ID})}).catch(()=>{}); }
    })();
    </script>
</body>
</html>