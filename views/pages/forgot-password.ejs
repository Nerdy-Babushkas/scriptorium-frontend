<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - Scriptorium</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Outfit:wght@300;400;600;700&family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-scriptorium-dark min-h-screen font-outfit text-white">
    <%- include('../partials/navbar') %>

    <div class="pt-24 flex justify-center px-6">
      <div
        class="w-full max-w-md bg-black/40 p-8 rounded-3xl border border-[#118AB2] shadow-xl"
      >
        <h1 class="font-dancing text-5xl mb-4 text-center">Forgot Password?</h1>

        <p class="text-white/70 text-center mb-6">
          Enter your email and we’ll send you a password reset link.
        </p>

        <form id="forgotForm" class="space-y-4">
          <div>
            <label class="block mb-1 font-bold">Email</label>
            <input
              type="email"
              id="email"
              required
              class="w-full h-[52px] px-5 rounded-full bg-transparent border border-[#118AB2] focus:border-[#06D6A0] outline-none"
            />
          </div>

          <button
            type="submit"
            class="w-full h-[52px] rounded-full bg-[#009A72] uppercase tracking-widest font-semibold hover:bg-[#008060]"
          >
            Send Reset Link
          </button>
        </form>

        <div id="message" class="hidden mt-4 text-center text-lg"></div>

        <div class="mt-6 text-center">
          <a href="/login" class="underline hover:text-scriptorium-green">
            Back to login
          </a>
        </div>
      </div>
    </div>

    <script>
      const form = document.getElementById("forgotForm");
      const message = document.getElementById("message");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        message.classList.add("hidden");

        const email = document
          .getElementById("email")
          .value.trim()
          .toLowerCase();

        try {
          const res = await fetch(
            "http://localhost:8080/api/user/forgot-password",
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email }),
            },
          );

          const data = await res.json();

          message.textContent =
            data.message || "If the email exists, a reset link was sent.";
          message.className = "mt-4 text-center text-green-300";
          message.classList.remove("hidden");
        } catch (err) {
          message.textContent = "Unable to connect to server.";
          message.className = "mt-4 text-center text-red-300";
          message.classList.remove("hidden");
        }
      });
    </script>
  </body>
</html>
