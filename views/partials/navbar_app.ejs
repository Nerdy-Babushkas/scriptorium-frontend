        <div class="flex items-center gap-4">
                    
                    <div class="relative">
                        <button id="profile-menu-btn" class="block w-10 h-10 rounded-full bg-white/20 overflow-hidden border border-white/30 hover:border-scriptorium-gold transition-colors focus:outline-none">
