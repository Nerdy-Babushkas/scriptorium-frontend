<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Search Results — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/search-results.css">
</head>
<body class="sr-body">

  <div class="grain" aria-hidden="true"></div>

  <%- include('../partials/navbar_app', { query, type }) %>

  <main class="sr-main">

    <!-- Header -->
    <div class="sr-header">
      <div>
        <h1 class="sr-title">
          Results for "<span id="queryDisplay" class="sr-title-query">...</span>"
        </h1>
        <div class="sr-tabs" style="margin-top:1rem;">
          <a href="#" id="tab-books"  class="sr-tab">📚 Books</a>
          <a href="#" id="tab-music"  class="sr-tab">🎵 Music</a>
          <a href="#" id="tab-movies" class="sr-tab">🎬 Movies</a>
        </div>
      </div>

      <div class="sr-room-links">
        <a href="/library" class="sr-room-link">Library</a>
        <span class="sr-room-sep">·</span>
        <a href="/music"   class="sr-room-link">Music Room</a>
        <span class="sr-room-sep">·</span>
        <a href="/theatre" class="sr-room-link">Theatre</a>
      </div>
    </div>

    <!-- Advanced Search -->
    <div class="sr-advanced-wrap" id="advancedSearchContainer">
      <button id="advancedSearchToggle" class="sr-advanced-toggle">
        <span>Advanced Search</span>
        <span id="accordionIcon" class="sr-accordion-icon">▼</span>
      </button>

      <div id="advancedSearch" class="sr-advanced-fields hidden">
        <!-- Universal -->
        <input type="text"    name="title"     placeholder="Title"     class="sr-field-input">

        <!-- Movie fields -->
        <input type="text"    name="actor"     placeholder="Actor"     class="sr-field-input">
        <input type="text"    name="genre"     placeholder="Genre"     class="sr-field-input">
        <input type="number"  name="movieYear" placeholder="Year" min="1900" class="sr-field-input">
        <select name="movieType" class="sr-field-select">
          <option value="">Any Type</option>
          <option value="movie">Movie</option>
          <option value="series">Series</option>
          <option value="episode">Episode</option>
        </select>

        <!-- Music fields (hidden by default) -->
        <input type="text"   name="artist"    placeholder="Artist"  class="music-field sr-field-input hidden">
        <input type="text"   name="release"   placeholder="Release" class="music-field sr-field-input hidden">
        <input type="number" name="musicYear" placeholder="Year" min="1900" class="music-field sr-field-input hidden">

        <!-- Book fields (hidden by default) -->
        <input type="text" name="author"    placeholder="Author"    class="book-field sr-field-input hidden">
        <input type="text" name="category"  placeholder="Category"  class="book-field sr-field-input hidden">
        <input type="text" name="publisher" placeholder="Publisher" class="book-field sr-field-input hidden">

        <button id="advancedSearchBtn" class="sr-advanced-btn">Search</button>
      </div>
    </div>

    <!-- Loading -->
    <div id="loadingState">
      <div class="sr-spinner"></div>
      <p class="sr-loading-text">Searching the archives…</p>
    </div>

    <!-- Results grid — JS populates this -->
    <div id="resultsGrid"></div>

    <!-- Pagination — JS populates this -->
    <div id="pagination"></div>

    <!-- Empty state -->
    <div id="emptyState">
      <div class="sr-empty-emoji">📭</div>
      <p class="sr-empty-title">Nothing found</p>
      <p class="sr-empty-sub">No items matched your search. Try different keywords.</p>
    </div>

  </main>

  <!-- Shelf Modal -->
  <div id="shelfModal">
    <div class="sr-modal-box">
      <span class="sr-modal-eyebrow">Save to shelf</span>
      <span id="modalBookTitle">this item</span>

      <div class="sr-shelf-options">
        <button id="btn-favourites" class="shelf-btn" data-shelf="favorites">
          <span class="shelf-btn-icon">⭐</span> Favourites
        </button>
        <button id="btn-wishlist" class="shelf-btn" data-shelf="wishlist">
          <span class="shelf-btn-icon">🔖</span>
          <span id="btn-wishlist-text">Watchlist</span>
        </button>
        <button id="btn-reading" class="shelf-btn" data-shelf="watching">
          <span class="shelf-btn-icon">🎬</span>
          <span id="btn-reading-text">Currently Watching</span>
        </button>
        <button id="btn-finished" class="shelf-btn" data-shelf="watched">
          <span class="shelf-btn-icon">✅</span>
          <span id="btn-finished-text">Finished</span>
        </button>
      </div>

      <div class="sr-modal-divider"></div>
      <button id="closeModal">Cancel</button>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast">
    <div>
      <h4 id="toastTitle"></h4>
      <p id="toastMessage"></p>
    </div>
  </div>

  <script src="/js/search_results.js"></script>
</body>
</html>
