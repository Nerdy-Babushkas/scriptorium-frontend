<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Scriptorium</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Outfit:wght@300;400;600;700&family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-scriptorium-dark min-h-screen font-outfit text-white">
    <%- include('../partials/navbar') %>

    <div class="pt-24 flex justify-center px-6">
      <div
        class="w-full max-w-md bg-black/40 p-8 rounded-3xl border border-[#118AB2] shadow-xl"
      >
        <h1 class="font-dancing text-5xl mb-6 text-center">Reset Password</h1>

        <form id="resetForm" class="space-y-4">
          <div>
            <label class="block mb-1 font-bold">New Password</label>
            <input
              type="password"
              id="password"
              required
              class="w-full h-[52px] px-5 rounded-full bg-transparent border border-[#118AB2] focus:border-[#06D6A0] outline-none"
            />
          </div>

          <div>
            <label class="block mb-1 font-bold">Confirm Password</label>
            <input
              type="password"
              id="confirm"
              required
              class="w-full h-[52px] px-5 rounded-full bg-transparent border border-[#118AB2] focus:border-[#06D6A0] outline-none"
            />
          </div>

          <button
            type="submit"
            class="w-full h-[52px] rounded-full bg-[#009A72] uppercase tracking-widest font-semibold hover:bg-[#008060]"
          >
            Reset Password
          </button>
        </form>

        <div id="message" class="hidden mt-4 text-center text-lg"></div>
      </div>
    </div>

    <script>
      const form = document.getElementById("resetForm");
      const message = document.getElementById("message");

      const token = window.location.pathname.split("/").pop();

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        message.classList.add("hidden");

        const password = document.getElementById("password").value;
        const confirm = document.getElementById("confirm").value;

        if (password !== confirm) {
          message.textContent = "Passwords do not match.";
          message.className = "mt-4 text-red-300";
          message.classList.remove("hidden");
          return;
        }

        try {
          const res = await fetch(
            "http://localhost:8080/api/user/reset-password",
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                token,
                password,
                password2: confirm,
              }),
            },
          );

          const data = await res.json();

          if (res.ok) {
            message.textContent = "Password reset successful! Redirecting...";
            message.className = "mt-4 text-green-300";
            message.classList.remove("hidden");

            setTimeout(() => {
              window.location.href = "/login";
            }, 2500);
          } else {
            message.textContent = data.message || "Reset failed.";
            message.className = "mt-4 text-red-300";
            message.classList.remove("hidden");
          }
        } catch (err) {
          message.textContent = "Unable to connect to server.";
          message.className = "mt-4 text-red-300";
          message.classList.remove("hidden");
        }
      });
    </script>
  </body>
</html>
