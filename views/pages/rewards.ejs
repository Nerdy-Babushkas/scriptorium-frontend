<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Rewards - Scriptorium' }) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/progress.css">
</head>

<%# ── BADGE UNLOCK MODAL ──────────────────────────────────────── %>
<div id="badgeUnlockModal">
  <div class="badge-unlock-box">
    <span class="unlock-eyebrow">✦ Badge unlocked</span>
    <span class="unlock-icon" id="unlockIcon"></span>
    <p class="unlock-title" id="unlockName"></p>
    <p class="unlock-desc"  id="unlockDesc"></p>
    <button class="unlock-close" id="unlockClose">Nice one!</button>
  </div>
</div>

<%# ── TOAST ────────────────────────────────────────────────────── %>
<div id="toast">
  <div>
    <div id="toastTitle"></div>
    <div id="toastMessage"></div>
  </div>
</div>

<body class="progress-body">

  <%# Grain texture — same as landing %>
  <div class="grain" aria-hidden="true"></div>

  <%# Custom cursor — JS drives translate3d, CSS only handles size/colour %>
  <div class="cursor" aria-hidden="true"></div>

  <%# Ambient orbs %>
  <div class="bg-orb bg-orb-1" aria-hidden="true"></div>
  <div class="bg-orb bg-orb-2" aria-hidden="true"></div>

  <%- include('../partials/navbar_app') %>

  <main class="progress-page">

    <%# ── PAGE HEADER ──────────────────────────────────────────── %>
    <div class="progress-header">
      <div class="progress-header-left">
        <a href="/room" class="btn-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Back
        </a>
        <div class="progress-title-group">
          <h1 class="progress-title">Rewards</h1>
          <span class="progress-subtitle">Streaks · Badges · Progress</span>
        </div>
      </div>
    </div>

    <%# ══ STREAK ════════════════════════════════════════════════ %>
    <p class="section-label">Daily streak</p>

    <div class="streak-card" id="streakCard">
      <%# Decorative watermark number — updated by JS %>
      <span class="streak-bg-num" id="streakBgNum" aria-hidden="true">0</span>

      <%# Skeleton shown while loading %>
      <div id="streakSkeleton">
        <div style="display:flex;gap:3rem;margin-bottom:1.5rem;">
          <div class="skeleton" style="width:90px;height:62px;border-radius:14px;"></div>
          <div class="skeleton" style="width:90px;height:62px;border-radius:14px;"></div>
        </div>
        <div class="skeleton" style="width:100%;height:10px;border-radius:100px;"></div>
        <div style="display:flex;gap:6px;margin-top:1.5rem;">
          <% for(let i = 0; i < 7; i++) { %>
          <div class="skeleton" style="flex:1;height:44px;border-radius:50%;"></div>
          <% } %>
        </div>
      </div>

      <%# Real streak content — injected and shown by rewards.js %>
      <div id="streakContent" style="display:none;"></div>
    </div>

    <%# ══ PROGRESS ══════════════════════════════════════════════ %>
    <div class="progress-section">
      <p class="section-label">Progress</p>
      <div class="progress-rows" id="progressRows">
        <div class="skeleton" style="height:80px;border-radius:18px;"></div>
        <div class="skeleton" style="height:80px;border-radius:18px;"></div>
        <div class="skeleton" style="height:80px;border-radius:18px;"></div>
        <div class="skeleton" style="height:80px;border-radius:18px;"></div>
      </div>
    </div>

    <%# ══ BADGES ════════════════════════════════════════════════ %>
    <div class="badges-section">
      <p class="section-label">Badges</p>

      <div class="badge-filter-row" id="filterRow">
        <button class="filter-btn active" data-cat="all"        onclick="filterBadges('all')">All</button>
        <button class="filter-btn" data-cat="streak"            onclick="filterBadges('streak')">🔥 Streaks</button>
        <button class="filter-btn" data-cat="reflection"        onclick="filterBadges('reflection')">✍️ Reflections</button>
        <button class="filter-btn" data-cat="media"             onclick="filterBadges('media')">📚 Media</button>
        <button class="filter-btn" data-cat="goal"              onclick="filterBadges('goal')">🎯 Goals</button>
        <button class="filter-btn" data-cat="milestone"         onclick="filterBadges('milestone')">🐣 Milestones</button>
      </div>

      <div class="badges-grid" id="badgesGrid">
        <% for(let i = 0; i < 8; i++) { %>
        <div class="skeleton" style="height:160px;border-radius:22px;"></div>
        <% } %>
      </div>
    </div>

  </main>

  <script src="/js/rewards.js"></script>

  <script>
    /* ── Cursor ─────────────────────────────────────────────────
       Mirrors landing.js exactly. JS drives translate3d so the
       CSS transition only applies to size/colour, not position.
    ────────────────────────────────────────────────────────────── */
    (function () {
      var cursor = document.querySelector('.cursor');
      if (!cursor) return;
      var mx = window.innerWidth / 2;
      var my = window.innerHeight / 2;

      document.addEventListener('mousemove', function (e) {
        mx = e.clientX;
        my = e.clientY;
        cursor.style.transform = 'translate3d(' + mx + 'px,' + my + 'px,0) translate(-50%,-50%)';
      });

      document.querySelectorAll('a,button,[role="button"]').forEach(function (el) {
        el.addEventListener('mouseenter', function () { cursor.classList.add('hov'); });
        el.addEventListener('mouseleave', function () { cursor.classList.remove('hov'); });
      });

      document.addEventListener('mousedown', function () { cursor.classList.add('clicking'); });
      document.addEventListener('mouseup',   function () { cursor.classList.remove('clicking'); });
    }());
  </script>
</body>
</html>
