<!--views/pages/progress.ejs-->

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Progress - Scriptorium</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Outfit:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              "scriptorium-brown": "#3E2723",
              "scriptorium-gold": "#FFDA6D",
              "card-bg": "rgba(20, 30, 35, 0.95)",
              "teal-neon": "#00C49A",
              "teal-dark": "#1B4B43",
              danger: "#D90429",
              "input-bg": "rgba(0, 0, 0, 0.4)",
            },
            fontFamily: {
              dancing: ['"Dancing Script"', "cursive"],
              outfit: ['"Outfit"', "sans-serif"],
              roboto: ['"Roboto"', "sans-serif"],
            },
          },
        },
      };
    </script>

    <style>
      /* Custom Scrollbar */
      .custom-scroll::-webkit-scrollbar {
        width: 6px;
      }
      .custom-scroll::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
      }
      .custom-scroll::-webkit-scrollbar-thumb {
        background: #00c49a;
        border-radius: 4px;
      }
      .custom-scroll::-webkit-scrollbar-thumb:hover {
        background: #00a07d;
      }

      @keyframes yarnFloat {
        0% {
          opacity: 0;
          transform: translateX(-50%) translateY(0px) scale(0.8);
        }
        20% {
          opacity: 1;
          transform: translateX(-50%) translateY(-8px) scale(1);
        }
        80% {
          opacity: 1;
          transform: translateX(-50%) translateY(-40px) scale(1);
        }
        100% {
          opacity: 0;
          transform: translateX(-50%) translateY(-58px) scale(0.9);
        }
      }
      @keyframes goalCompletePop {
        0% {
          opacity: 0;
          transform: translateX(-50%) scale(0.5);
        }
        40% {
          opacity: 1;
          transform: translateX(-50%) scale(1.15);
        }
        70% {
          transform: translateX(-50%) scale(0.95);
        }
        100% {
          opacity: 1;
          transform: translateX(-50%) scale(1);
        }
      }
    </style>
  </head>
  <body
    class="min-h-screen relative font-outfit text-white overflow-hidden flex flex-col"
  >
    <div class="fixed inset-0 z-0">
      <img
        src="/assets/room2.png"
        alt="Room Background"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="fixed inset-0 z-0 bg-black/75 backdrop-blur-[6px]"></div>
    <%- include('../partials/navbar_app') %>
    <a
      href="/room"
      class="absolute top-36 left-10 z-20 flex items-center gap-2 px-4 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 hover:border-scriptorium-gold transition-all group"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        class="text-white group-hover:text-scriptorium-gold transition-colors"
      >
        <path
          d="M19 12H5M12 19L5 12L12 5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span
        class="font-outfit text-sm font-medium text-white group-hover:text-scriptorium-gold transition-colors"
        >Back to Room</span
      >
    </a>
    <main class="relative z-10 flex-grow flex items-center justify-center p-4">
      <div
        class="w-full max-w-2xl h-[80vh] bg-card-bg rounded-[30px] border border-teal-neon/30 shadow-[0_0_50px_rgba(0,196,154,0.15)] p-8 backdrop-blur-xl flex flex-col relative overflow-visible"
      >
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-teal-neon blur-md shadow-[0_0_20px_#00C49A]"
        ></div>

        <h1
          class="font-dancing text-5xl text-white text-center mb-6 drop-shadow-md shrink-0"
        >
          Progress
        </h1>

        <div
          class="flex bg-black/30 rounded-full p-1 w-max mx-auto mb-6 border border-white/10 shrink-0"
        >
          <button
            onclick="filterGoals('active')"
            id="btn-active"
            class="px-6 py-1.5 rounded-full bg-teal-neon/20 text-teal-neon border border-teal-neon font-medium text-sm transition-all"
          >
            Active Goals
          </button>
          <button
            onclick="filterGoals('completed')"
            id="btn-completed"
            class="px-6 py-1.5 rounded-full text-white/50 hover:text-white font-medium text-sm transition-all"
          >
            Completed
          </button>
        </div>

        <div
          id="goals-container"
          class="flex-1 flex flex-col gap-3 overflow-y-auto custom-scroll pr-2 mb-6"
        ></div>

        <div class="flex justify-center gap-4 mt-auto shrink-0">
          <button
            onclick="openModal()"
            class="bg-teal-neon text-black font-outfit font-bold text-sm px-8 py-3 rounded-full uppercase tracking-wider hover:bg-white hover:scale-105 transition-all shadow-lg shadow-teal-neon/20"
          >
            Add a Goal
          </button>
          <button
            type="button"
            onclick="deleteSelectedActiveGoal(event)"
            class="bg-danger text-white font-outfit font-bold text-sm px-8 py-3 rounded-full uppercase tracking-wider hover:bg-red-600 hover:scale-105 transition-all shadow-lg"
          >
            Delete a Goal
          </button>
        </div>
      </div>
    </main>

    <div
      id="goal-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4 animate-fade-in"
    >
      <div
        class="w-full max-w-md bg-card-bg border border-teal-neon/30 rounded-2xl p-6 shadow-2xl relative"
      >
        <h2 class="font-outfit text-2xl font-bold text-white mb-6">
          Create a new goal
        </h2>

        <div class="space-y-4">
          <div>
            <label class="block text-white/70 text-sm mb-1 font-medium"
              >Goal Name/Description</label
            >
            <input
              type="text"
              id="modal-title"
              class="w-full bg-input-bg border border-white/10 rounded-lg px-4 py-2 text-white focus:border-teal-neon focus:outline-none transition-colors"
              placeholder="e.g. Read 5 chapters"
            />
          </div>

          <div>
            <label class="block text-white/70 text-sm mb-1 font-medium"
              >Goal Type</label
            >
            <select
              id="modal-type"
              class="w-full bg-input-bg border border-white/10 rounded-lg px-4 py-2 text-white focus:border-teal-neon focus:outline-none transition-colors"
            >
              <option value="book">Book</option>
              <option value="music">Music</option>
              <option value="movies">Movies</option>
            </select>
          </div>

          <div>
            <label class="block text-white/70 text-sm mb-1 font-medium"
              >Target Value</label
            >
            <input
              type="number"
              id="modal-target"
              min="0"
              step="1"
              class="w-full bg-input-bg border border-white/10 rounded-lg px-4 py-2 text-white focus:border-teal-neon focus:outline-none transition-colors"
              placeholder="e.g. 10"
            />
          </div>

          <div>
            <label class="block text-white/70 text-sm mb-1 font-medium"
              >Current Progress</label
            >
            <input
              type="number"
              id="modal-current"
              min="0"
              step="1"
              class="w-full bg-input-bg border border-white/10 rounded-lg px-4 py-2 text-white focus:border-teal-neon focus:outline-none transition-colors"
              placeholder="e.g. 0"
            />
          </div>
          <div class="relative">
            <label class="block text-white/70 text-sm mb-1 font-medium"
              >Attach a piece of media</label
            >
            <input
              type="text"
              id="modal-media-search"
              class="w-full bg-input-bg border border-white/10 rounded-lg px-4 py-2 text-white focus:border-teal-neon focus:outline-none transition-colors"
              placeholder="N/A"
              value="N/A"
              autocomplete="off"
            />
            <div
              id="media-search-results"
              class="hidden absolute z-50 mt-2 w-full max-h-56 overflow-y-auto rounded-lg border border-white/10 bg-[#081014] shadow-xl"
            ></div>
          </div>
        </div>

        <div class="flex justify-end gap-3 mt-8">
          <button
            onclick="closeModal()"
            class="text-white/70 hover:text-white font-medium px-4 py-2 transition-colors"
          >
            CANCEL
          </button>
          <button
            onclick="saveGoalFromModal()"
            class="bg-teal-neon text-black font-bold px-6 py-2 rounded-lg hover:bg-white transition-colors"
          >
            SAVE
          </button>
        </div>
      </div>
    </div>

    <script src="/js/progress.js"></script>
  </body>
</html>
