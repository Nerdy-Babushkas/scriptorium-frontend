<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Forgot Password — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/auth.css">
</head>

<body class="auth-body">

  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>

  <a href="/" class="auth-back" aria-label="Back to home">
    <span class="auth-back-arrow">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="auth-back-label">
      <span class="auth-back-label-text">Scriptorium</span>
      <svg class="auth-back-squiggle" viewBox="0 0 60 5" fill="none" aria-hidden="true">
        <path d="M1 3 Q10 1 20 3 Q30 5 40 3 Q50 1 59 3" stroke="#3d8c80" stroke-width="1.8" stroke-linecap="round" fill="none"/>
      </svg>
    </span>
  </a>

  <div class="auth-page auth-page--forgot">

    <!-- LEFT: form -->
    <div class="auth-panel-right">
      <div class="auth-form-wrap">

        <div class="auth-heading">
          <p class="auth-eyebrow">Account recovery</p>
          <h1>
            Forgot your<br>
            <span class="caveat-word">password?</span>
          </h1>
          <p class="auth-heading-sub">
            No worries — enter your email and we'll send a reset link your way.
          </p>
        </div>

        <form class="auth-form" id="forgotForm" novalidate>

          <div class="auth-field">
            <label class="auth-label" for="email">Email address</label>
            <input
              class="auth-input"
              type="email"
              id="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              required
            />
          </div>

          <div id="message" class="hidden" role="alert" aria-live="polite"></div>

          <button type="submit" id="submitBtn">
            Send Reset Link
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M2 10h14M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

        </form>

        <a href="/login" class="auth-back-to-login">← Back to login</a>

      </div>
    </div>

    <!-- RIGHT: decorative panel -->
    <div class="auth-panel-left auth-panel-left--forgot" aria-hidden="true">
      <div class="auth-panel-noise"></div>
      <div class="auth-bleed-word">OOF</div>

      <span class="auth-emoji-hero auth-emoji-hero--forgot" role="img" aria-label="Thinking face">🤔</span>

      <div class="auth-floater auth-floater--note">
        <svg viewBox="0 0 90 88" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="88" height="86" rx="4" fill="#f5e87a" transform="rotate(-5 0 0)"/>
          <rect width="88" height="11" rx="4" fill="#e8d660" transform="rotate(-5 0 0)"/>
          <line x1="12" y1="28" x2="70" y2="25" stroke="#c8b840" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="12" y1="40" x2="68" y2="37" stroke="#c8b840" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="12" y1="52" x2="52" y2="49" stroke="#c8b840" stroke-width="1.5" stroke-linecap="round"/>
          <text x="60" y="72" font-size="18" fill="#c8b840" font-weight="bold" opacity="0.6">?</text>
        </svg>
      </div>

      <div class="auth-floater auth-floater--star">
        <svg viewBox="0 0 60 60" fill="none">
          <path d="M30 4L33 26L55 30L33 34L30 56L27 34L5 30L27 26Z" fill="#bf7a30" opacity="0.6"/>
        </svg>
      </div>
      <div class="auth-floater auth-floater--star2">
        <svg viewBox="0 0 40 40" fill="none">
          <path d="M20 2L22.8 16.2L37 20L22.8 23.8L20 38L17.2 23.8L3 20L17.2 16.2Z" fill="#c05868" opacity="0.55"/>
        </svg>
      </div>
      <div class="auth-floater auth-floater--arc">
        <svg viewBox="0 0 150 50" fill="none">
          <path d="M4 36 Q32 4 62 26 Q92 48 122 16 Q136 7 148 14" stroke="#bf7a30" stroke-width="2.8" stroke-linecap="round" fill="none" opacity="0.38" stroke-dasharray="5 4"/>
        </svg>
      </div>

      <div class="auth-panel-tagline">
        <p class="auth-panel-eyebrow">— It happens to everyone</p>
        <h2>We've got<br><span class="caveat-word">you covered.</span></h2>
        <p>Just drop your email and we'll send a secure reset link straight to your inbox. Back in seconds.</p>
      </div>

      <div class="auth-preview-cards">
        <div class="auth-preview-card">
          <div class="apc-dot apc-dot--amber"></div>
          <div class="apc-text">
            <strong>Secure reset link</strong>
            <span>Expires in 1 hour</span>
          </div>
          <span class="apc-badge">Safe</span>
        </div>
        <div class="auth-preview-card">
          <div class="apc-dot apc-dot--teal"></div>
          <div class="apc-text">
            <strong>Your data is safe</strong>
            <span>Nothing changes until you reset</span>
          </div>
          <span class="apc-badge">Secure</span>
        </div>
      </div>
    </div>

  </div>

  <script>
    const form    = document.getElementById('forgotForm');
    const message = document.getElementById('message');
    const button  = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      message.classList.add('hidden');
      button.disabled    = true;
      button.textContent = 'Sending...';

      const email = document.getElementById('email').value.trim().toLowerCase();

      try {
        const res = await fetch(
          'https://scriptorium-backend-six.vercel.app/api/user/forgot-password',
          { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) }
        );
        const data = await res.json();
        message.textContent = data.message || '✅ If an account with that email exists, a password reset link has been sent.';
        message.className = 'mt-4 text-center text-green-300 font-medium';
        message.classList.remove('hidden');
        form.reset();
      } catch (err) {
        message.textContent = '❌ Unable to connect to the server. Please try again.';
        message.className   = 'mt-4 text-center text-red-300 font-medium';
        message.classList.remove('hidden');
      } finally {
        button.disabled  = false;
        button.innerHTML = `Send Reset Link
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M2 10h14M12 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>`;
      }
    });
  </script>

</body>
</html>
