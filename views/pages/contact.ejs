<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head_public', { title: 'Contact — Scriptorium' }) %>
  <link rel="stylesheet" href="/css/landing.css">
  <link rel="stylesheet" href="/css/pages.css">
</head>
<body class="page-body">

  <div class="grain" aria-hidden="true"></div>
  <div class="page-orb page-orb-1" aria-hidden="true"></div>
  <div class="page-orb page-orb-2" aria-hidden="true"></div>

  <%- include('../partials/navbar_public') %>

  <main class="page-main page-main--wide">

    <!-- Hero -->
    <div class="contact-hero">
      <div>
        <div class="page-eyebrow">Get in touch</div>
        <h1 class="page-h1">Contact <span class="caveat">Babushka</span></h1>
        <p class="page-sub">
          We're building something special in our digital nesting doll.
          Connect with us directly or check out our code.
        </p>

        <div class="contact-links">
          <a href="mailto:babushkas.prj@gmail.com" class="contact-link">
            <div class="contact-link-icon contact-link-icon--teal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <span class="contact-link-label">Email us</span>
              <span class="contact-link-value">babushkas.prj@gmail.com</span>
            </div>
          </a>

          <a href="https://github.com/Nerdy-Babushkas" target="_blank" rel="noopener" class="contact-link">
            <div class="contact-link-icon contact-link-icon--ink">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <span class="contact-link-label">Check the code</span>
              <span class="contact-link-value">Nerdy-Babushkas</span>
            </div>
          </a>

          <a href="/feedback" class="contact-link">
            <div class="contact-link-icon contact-link-icon--lavender">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
              </svg>
            </div>
            <div>
              <span class="contact-link-label">Share feedback</span>
              <span class="contact-link-value">Got thoughts? Tell us</span>
            </div>
          </a>
        </div>
      </div>

      <div class="contact-doll-img">
        <img src="/assets/doll.png" alt="Matryoshka doll" />
      </div>
    </div>

    <!-- Team section -->
    <div class="team-section">

      <div style="margin-bottom: 4rem;">
        <div class="page-eyebrow">The team</div>
        <h2 class="team-section-title">Meet the <span style="font-family: var(--font-caveat); color: var(--teal);">Babushkas</span></h2>
        <p class="team-section-sub">Five minds. Five animals. One digital nesting doll.</p>
      </div>

      <div class="team-member">
        <div class="team-member-img">
          <img src="/assets/bunny-babushka.png" alt="Bunny Babushka — Pranjal Surjan" />
        </div>
        <div class="team-member-info">
          <h3 class="team-member-name">Pranjal Surjan</h3>
          <p class="team-member-role">Team Captain · Frontend Lead</p>
          <p class="team-member-bio">She is doing tOOOOO much. Pranjal leads the team with a blend of vision and hands-on coding, shaping this amazing frontend experience while steering the project towards success.</p>
        </div>
      </div>

      <div class="team-member team-member--reverse">
        <div class="team-member-img">
          <img src="/assets/panther-babushka.png" alt="Panther Babushka — Dylan Musiiwa" />
        </div>
        <div class="team-member-info">
          <h3 class="team-member-name">Dylan Musiiwa</h3>
          <p class="team-member-role">Gamification & Engagement Lead</p>
          <p class="team-member-bio">Playful and strategic. Dylan infuses gamification elements that captivate users, creating an engaging and rewarding experience within our digital nesting doll.</p>
        </div>
      </div>

      <div class="team-member">
        <div class="team-member-img">
          <img src="/assets/penguin-babushka.png" alt="Penguin Babushka — Maksym Syromolot" />
        </div>
        <div class="team-member-info">
          <h3 class="team-member-name">Maksym Syromolot</h3>
          <p class="team-member-role">Backend Engineer</p>
          <p class="team-member-bio">Maksym is our backend wizard, building robust and scalable systems that power our digital nesting doll.</p>
        </div>
      </div>

      <div class="team-member team-member--reverse">
        <div class="team-member-img">
          <img src="/assets/capybara-babushka.png" alt="Capybara Babushka — Nelson Antonini" />
        </div>
        <div class="team-member-info">
          <h3 class="team-member-name">Nelson Antonini</h3>
          <p class="team-member-role">Backend Lead</p>
          <p class="team-member-bio">He is our team father ('papi' in Brazilian). Nelson provides stability and guidance, ensuring our backend is robust and scalable while mentoring the team with his experience and wisdom.</p>
        </div>
      </div>

      <div class="team-member">
        <div class="team-member-img">
          <img src="/assets/sea-lion-babushka.png" alt="Sea Lion Babushka — Harjasdeep Singh" />
        </div>
        <div class="team-member-info">
          <h3 class="team-member-name">Harjasdeep Singh</h3>
          <p class="team-member-role">Feature Engineer & Tester</p>
          <p class="team-member-bio">Harjasdeep is our feature maestro, crafting and testing new functionalities to ensure a seamless user experience within our digital reflecting space.</p>
        </div>
      </div>

    </div>
  </main>

</body>
</html>
