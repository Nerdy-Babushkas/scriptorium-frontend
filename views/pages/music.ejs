<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Music Room - Scriptorium' }) %>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
    <style>
        #container3d { width: 100%; height: 100vh; display: block; }
        @keyframes zoomIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        .animate-zoom-in { animation: zoomIn 0.3s ease-out forwards; }
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); }
        .custom-scroll::-webkit-scrollbar-thumb { background: #00C49A; border-radius: 4px; }
    </style>
</head>
<body class="bg-[#050a1a] min-h-screen overflow-hidden font-outfit text-white">

    <%- include('../partials/navbar_app') %>

    <div id="container3d"></div>

    <!-- BACK BUTTON -->
    <a href="/room" class="fixed top-20 left-4 z-20 flex items-center gap-2 px-4 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 transition-all">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-white"><path d="M19 12H5M12 19L5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="font-outfit text-sm font-medium text-white">Back to Room</span>
    </a>

    <!-- NAV BUTTONS -->
    <div class="fixed top-20 right-4 z-20 flex items-center gap-3">
        <a href="/library" class="px-5 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 transition-all">
            <span class="font-outfit text-sm font-medium text-white">Library</span>
        </a>
        <a href="/theatre" class="px-5 py-2 bg-black/60 backdrop-blur-md border border-white/20 rounded-full hover:bg-black/80 transition-all">
            <span class="font-outfit text-sm font-medium text-white">Theatre</span>
        </a>
        <%- include('../partials/ai_button') %>
    </div>

    <!-- SHELF MODAL -->
    <div id="shelfViewModal" class="hidden fixed inset-0 z-50 bg-[#0f191e]/95 backdrop-blur-xl p-6 overflow-hidden flex flex-col animate-zoom-in">
        <div class="flex justify-between items-center mb-8 max-w-7xl mx-auto w-full border-b border-white/10 pb-6 shrink-0">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-[#00C49A]/20 rounded-xl border border-[#00C49A]">
                    <span class="text-2xl">🎵</span>
                </div>
                <div>
                    <h2 id="shelfTitle" class="text-4xl font-dancing text-white">Shelf Name</h2>
                    <p class="text-white/50 text-sm mt-1"><span id="bookCount">0</span> tracks stored</p>
                </div>
            </div>
            <button onclick="closeShelf()" class="flex items-center gap-2 px-6 py-2 rounded-full border border-red-500/50 text-red-400 hover:bg-red-500 hover:text-white transition-all">
                <span class="font-bold text-sm uppercase tracking-wider">Close</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="flex-grow overflow-y-auto custom-scroll w-full max-w-7xl mx-auto pr-2">
            <div id="shelfLoading" class="hidden flex flex-col items-center justify-center h-64">
                <div class="w-16 h-16 border-4 border-[#00C49A]/30 border-t-[#00C49A] rounded-full animate-spin mb-4"></div>
                <p class="text-[#00C49A] animate-pulse">Loading tracks...</p>
            </div>
            <div id="shelfGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-8 pb-20"></div>
            <div id="shelfEmpty" class="hidden flex flex-col items-center justify-center h-64 opacity-60">
                <p class="text-xl font-medium text-white/70">No music here yet.</p>
                <a href="/search?type=music" class="mt-4 px-6 py-2 rounded-full bg-[#00C49A]/20 text-[#00C49A] border border-[#00C49A] hover:bg-[#00C49A] hover:text-[#05181c] transition-all font-bold text-sm">Find Music</a>
            </div>
        </div>
    </div>

    <script>
        const searchForm = document.querySelector('form[action="/search"]');
        if (searchForm) {
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'type';
            hiddenInput.value = 'music';
            searchForm.appendChild(hiddenInput);
        }
    </script>
    <script src="/js/library.js"></script>
    <script type="module" src="/js/music-3d.js"></script>
</body>
</html>