<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { title: 'Movie Recommendations - Scriptorium' }) %>
    <style>
    /* ---------------- MOVIE CARDS ---------------- */
    .movie-card { 
        background: #1f1f1f; 
        border: 1px solid #FFDA6D50; 
        border-radius: 12px; 
        overflow: hidden; 
        transition: transform 0.2s ease, opacity 0.3s ease; 
    }

    .movie-card:hover { 
        transform: scale(1.03); 
    }

    .movie-poster { 
        width: 100%; 
        height: 300px; 
        object-fit: cover; 
    }

    /* ---------------- LOADING UI ---------------- */
    #recommendationsLoading {
        position: relative;
    }

    /* subtle glowing aura behind sheep */
    #recommendationsLoading::before {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        background: radial-gradient(circle, rgba(255,218,109,0.15), transparent 70%);
        border-radius: 50%;
        z-index: -1;
        animation: auraPulse 4s ease-in-out infinite;
    }

    @keyframes auraPulse {
        0%, 100% { transform: scale(0.95); opacity: 0.6; }
        50% { transform: scale(1.1); opacity: 1; }
    }

    /* sheep wrapper: floating and zooming */
    .sheep-wrapper {
        width: 160px;
        filter: drop-shadow(0 0 14px rgba(255, 218, 109, 0.25));
        position: relative;
        animation: sheepFloat 4s ease-in-out infinite;
    }

    @keyframes sheepFloat {
        0%   { transform: translateY(0px) scale(1); }
        50%  { transform: translateY(-8px) scale(1.05); }
        100% { transform: translateY(0px) scale(1); }
    }

    .sheep-img {
        width: 100%;
        display: block;
    }

    /* yarn animation: magical flowing thread */
    .sheep-wrapper::after {
        content: '';
        display: block;
        margin: 14px auto 0;
        width: 120px;
        height: 4px;
        border-radius: 2px;
        background: linear-gradient(90deg, transparent, #FFDA6D, transparent);
        background-size: 200%;
        opacity: 0.9;
        animation: yarnFlow 1.6s linear infinite;
    }

    @keyframes yarnFlow {
        0%   { background-position: -120px; }
        100% { background-position: 120px; }
    }

    /* loading text: breathing flicker */
    #loadingText {
        color: #FFDA6D;
        text-shadow: 0 0 8px rgba(255, 218, 109, 0.4);
        animation: textBreath 3s ease-in-out infinite;
        margin-top: 1.5rem;
        text-align: center;
        font-size: 1.125rem; /* text-lg */
        font-weight: 500; /* medium */
    }

    @keyframes textBreath {
        0%, 100% { opacity: 0.85; }
        50% { opacity: 1; }
    }

    /* typing dots animation */
    .dots::after {
        content: '';
        animation: dots 1.5s steps(3, end) infinite;
    }

    @keyframes dots {
        0%   { content: ''; }
        33%  { content: '.'; }
        66%  { content: '..'; }
        100% { content: '...'; }
    }

    /* smooth fade-out for loading */
    .fade-out {
        opacity: 0;
        transition: opacity 0.4s ease;
    }
    </style>
</head>

<body class="bg-[#2C1810] min-h-screen relative overflow-x-hidden font-outfit text-white">
    <%- include('../partials/navbar_app') %>

    <main class="relative z-0 mt-6 px-4 md:px-8 max-w-[1400px] mx-auto pb-12">

        <h1 class="text-4xl font-dancing text-white mb-6">
            AI Movie Recommendations
        </h1>

        <!-- GRID -->
        <div id="recommendationsGrid" class="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-8"></div>

        <!-- EMPTY -->
        <div id="recommendationsEmpty" class="text-center text-white/50 hidden mt-8"></div>

        <!-- 🐑 LOADING -->
        <div id="recommendationsLoading" class="flex flex-col items-center mt-16">

            <div class="sheep-wrapper">
                <img src="/assets/sheep-knitting.gif" class="sheep-img"/>
            </div>

            <p id="loadingText" class="text-[#FFDA6D] mt-6 text-lg font-medium text-center">
                Babushka AI is knitting your recommendations<span class="dots"></span>
            </p>

        </div>

    </main>

   <script src="/js/recommendations.js"></script>

</body>
</html>