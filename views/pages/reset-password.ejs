<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password — Scriptorium</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/auth.css">
</head>

<body class="auth-body">

  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>

  <%# Back button %>
  <a href="/" class="auth-back" aria-label="Back to home">
    <span class="auth-back-arrow">
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="auth-back-label">
      <span class="auth-back-label-text">Scriptorium</span>
      <svg class="auth-back-squiggle" viewBox="0 0 60 5" fill="none" aria-hidden="true">
        <path d="M1 3 Q10 1 20 3 Q30 5 40 3 Q50 1 59 3" stroke="#3d8c80" stroke-width="1.8" stroke-linecap="round" fill="none"/>
      </svg>
    </span>
  </a>

  <%#
    Reset page: form on RIGHT, panel on LEFT — same order as signup.
    Panel uses deep teal (auth-panel-left--reset).
  %>
  <div class="auth-page">

    <%# ══════════════════════════════════════════════
        LEFT PANEL — decorative, teal gradient
        Vibe: fresh start, you've got this
    ══════════════════════════════════════════════ %>
    <div class="auth-panel-left auth-panel-left--reset" aria-hidden="true">
      <div class="auth-panel-noise"></div>

      <div class="auth-bleed-word">NEW</div>

      <%# Big hero emoji — triumphant, fresh start %>
      <span class="auth-emoji-hero auth-emoji-hero--reset" role="img" aria-label="Sparkles">✨</span>

      <%# Floating SVGs %>

      <%# Book stack — fresh page %>
      <div class="auth-floater auth-floater--books">
        <svg viewBox="0 0 110 120" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="6" y="22" width="86" height="18" rx="3" fill="#c9b99a" transform="rotate(-7 6 22)"/>
          <rect x="6" y="22" width="11" height="18" rx="2" fill="#a89878" transform="rotate(-7 6 22)"/>
          <rect x="4" y="44" width="90" height="22" rx="3" fill="#a8c4b8" transform="rotate(-2 4 44)"/>
          <rect x="4" y="44" width="12" height="22" rx="2" fill="#7aaa98" transform="rotate(-2 4 44)"/>
          <rect x="2" y="70" width="94" height="26" rx="3" fill="#d4a8a8" transform="rotate(3 2 70)"/>
          <rect x="2" y="70" width="13" height="26" rx="2" fill="#bc8888" transform="rotate(3 2 70)"/>
          <path d="M70 70 L70 90 L65 85 L60 90 L60 70Z" fill="#e8c87a"/>
          <ellipse cx="52" cy="104" rx="44" ry="5" fill="rgba(0,0,0,0.07)"/>
        </svg>
      </div>

      <%# Teal star %>
      <div class="auth-floater auth-floater--star">
        <svg viewBox="0 0 60 60" fill="none">
          <path d="M30 4L33 26L55 30L33 34L30 56L27 34L5 30L27 26Z" fill="#3d8c80" opacity="0.6"/>
        </svg>
      </div>

      <%# Amber small star %>
      <div class="auth-floater auth-floater--star2">
        <svg viewBox="0 0 40 40" fill="none">
          <path d="M20 2L22.8 16.2L37 20L22.8 23.8L20 38L17.2 23.8L3 20L17.2 16.2Z" fill="#bf7a30" opacity="0.6"/>
        </svg>
      </div>

      <%# Arc scribble %>
      <div class="auth-floater auth-floater--arc">
        <svg viewBox="0 0 150 50" fill="none">
          <path d="M4 36 Q32 4 62 26 Q92 48 122 16 Q136 7 148 14"
            stroke="#3d8c80" stroke-width="2.8" stroke-linecap="round"
            fill="none" opacity="0.4" stroke-dasharray="5 4"/>
        </svg>
      </div>

      <div class="auth-panel-tagline">
        <p class="auth-panel-eyebrow">— Fresh start</p>
        <h2>
          Make it a<br>
          <span class="caveat-word">good one.</span>
        </h2>
        <p>Choose something strong. You're back in your space in seconds.</p>
      </div>

      <%# Password tip cards %>
      <div class="auth-preview-cards">
        <div class="auth-preview-card">
          <div class="apc-dot apc-dot--teal"></div>
          <div class="apc-text">
            <strong>Use 8+ characters</strong>
            <span>Mix letters, numbers & symbols</span>
          </div>
          <span class="apc-badge">Tip</span>
        </div>
        <div class="auth-preview-card">
          <div class="apc-dot apc-dot--amber"></div>
          <div class="apc-text">
            <strong>Avoid the obvious</strong>
            <span>No "password123" this time 😅</span>
          </div>
          <span class="apc-badge">Tip</span>
        </div>
      </div>

    </div>

    <%# ══════════════════════════════════════════════
        RIGHT PANEL — form
        Backend IDs preserved:
          resetForm, password, confirm, message
        Token: window.location.pathname.split('/').pop()
        API:   POST /api/user/reset-password
        Body:  { token, password, password2: confirm }
    ══════════════════════════════════════════════ %>
    <div class="auth-panel-right">
      <div class="auth-form-wrap">

        <div class="auth-heading">
          <p class="auth-eyebrow">Password reset</p>
          <h1>
            Choose a<br>
            <span class="caveat-word">new password.</span>
          </h1>
          <p class="auth-heading-sub">
            Make it something memorable — and strong.
          </p>
        </div>

        <form class="auth-form" id="resetForm" novalidate>

          <div class="auth-field">
            <label class="auth-label" for="password">New password</label>
            <div class="auth-input-wrap">
              <input
                class="auth-input"
                type="password"
                id="password"
                name="password"
                placeholder="Create a strong password"
                autocomplete="new-password"
                required
              />
              <button type="button" class="auth-toggle-btn" id="togglePassword" aria-label="Show password"></button>
            </div>
          </div>

          <div class="auth-field">
            <label class="auth-label" for="confirm">Confirm new password</label>
            <div class="auth-input-wrap">
              <input
                class="auth-input"
                type="password"
                id="confirm"
                name="confirm"
                placeholder="Repeat your new password"
                autocomplete="new-password"
                required
              />
              <button type="button" class="auth-toggle-btn" id="toggleConfirm" aria-label="Show confirm password"></button>
            </div>
          </div>

          <%# id="message" preserved — backend JS manipulates className %>
          <div id="message" class="hidden" role="alert" aria-live="polite"></div>

          <button type="submit" id="submitBtn">
            Reset Password
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

        </form>

        <a href="/login" class="auth-back-to-login">
          ← Back to login
        </a>

      </div>
    </div>

  </div>

  <script src="/js/auth-nav.js" defer></script>

  <%#
    ══════════════════════════════════════════════
    BACKEND SCRIPT — preserved exactly from original.
    IDs used: resetForm, password, confirm, message
    Token: window.location.pathname.split('/').pop()
    API:   POST https://scriptorium-backend-six.vercel.app/api/user/reset-password
    Body:  { token, password, password2: confirm }
    On success: redirect to /login after 2500ms
    ══════════════════════════════════════════════
  %>
  <script>
    const form    = document.getElementById('resetForm');
    const message = document.getElementById('message');

    // Get token from URL — preserved from original
    const token = window.location.pathname.split('/').pop();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      message.classList.add('hidden');

      const password = document.getElementById('password').value;
      const confirm  = document.getElementById('confirm').value;

      if (password !== confirm) {
        message.textContent = 'Passwords do not match.';
        message.className   = 'mt-4 text-center text-red-300 font-medium';
        message.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(
          'https://scriptorium-backend-six.vercel.app/api/user/reset-password',
          {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            // body preserved exactly — password2: confirm matches original
            body: JSON.stringify({ token, password, password2: confirm }),
          }
        );

        const data = await res.json();

        if (res.ok) {
          message.textContent = 'Password reset successful! Redirecting to login...';
          message.className   = 'mt-4 text-center text-green-300 font-medium';
          message.classList.remove('hidden');

          setTimeout(() => { window.location.href = '/login'; }, 2500);
        } else {
          message.textContent = data.message || 'Reset failed.';
          message.className   = 'mt-4 text-center text-red-300 font-medium';
          message.classList.remove('hidden');
        }
      } catch (err) {
        message.textContent = 'Unable to connect to server.';
        message.className   = 'mt-4 text-center text-red-300 font-medium';
        message.classList.remove('hidden');
      }
    });
  </script>

</body>
</html>
