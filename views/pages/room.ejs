<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head', { title: 'The Room - Scriptorium' }) %>

    <script type="importmap">
    {
        "imports": {
            "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
            "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
        }
    }
    </script>

    <style>
        body {
            margin: 0;
            overflow: hidden;
            background: #1a0f0a;
            font-family: 'Outfit', sans-serif;
        }

        #container3d {
            width: 100vw;
            height: 100vh;
            display: block;
        }

        /* NAV */
        .room-nav {
            position: fixed;
            top: 120px;
            right: 32px;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 16px;
        }

        .nav-pill {
            padding: 12px 28px;
            background: rgba(15, 25, 30, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 99px;
            color: white;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: 0.3s;
            min-width: 120px;
            text-align: center;
        }

        .nav-pill:hover {
            border-color: #FFDA6D;
            color: #FFDA6D;
            transform: translateX(-6px);
        }

        .ai-btn-container {
            margin-top: 8px;
        }

        /* ===== TIP SYSTEM ===== */

        #tipOverlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            backdrop-filter: blur(6px);
            z-index: 998;
            display: none;
        }

        #tipBox {
            position: fixed;
            bottom: 30px;
            left: 30px;

            width: 340px;
            background: rgba(20, 30, 35, 0.95);
            backdrop-filter: blur(15px);

            color: white;
            padding: 20px;
            border-radius: 16px;

            z-index: 999;
            display: none;

            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        }

        #tipContent {
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        #tipContent strong {
            display: block;
            font-size: 16px;
            margin-bottom: 6px;
        }

        /* DOTS */
        #tipDots {
            display: flex;
            justify-content: center;
            gap: 6px;
            margin-bottom: 12px;
        }

        /* ARROWS */
        .tip-nav {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .tip-nav button {
            background: rgba(255,255,255,0.1);
            border: none;
            color: white;
            padding: 6px 10px;
            border-radius: 8px;
            cursor: pointer;
        }

        .tip-nav button:hover {
            background: rgba(255,255,255,0.2);
        }

        /* ACTION BUTTONS */
        .tip-actions {
            display: flex;
            gap: 10px;
        }

        .tip-actions button {
            flex: 1;
            padding: 8px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            font-size: 13px;
        }

        #closeTip {
            background: #4CAF50;
            color: white;
        }

        #disableTips {
            background: rgba(255,255,255,0.15);
            color: white;
        }

        #closeTip:hover {
            background: #45a049;
        }

        #disableTips:hover {
            background: rgba(255,255,255,0.25);
        }

    </style>
</head>

<body>

    <%- include('../partials/navbar_app') %>

    <div id="container3d"></div>

    <!-- NAV -->
    <div class="room-nav">
        <a href="/library" class="nav-pill">Library</a>
        <a href="/music" class="nav-pill">Music Room</a>
        <a href="/theatre" class="nav-pill">Theatre</a>
        <div class="ai-btn-container">
            <%- include('../partials/ai_button') %>
        </div>
    </div>

    <!-- ===== TIP UI ===== -->
    <div id="tipOverlay"></div>

    <div id="tipBox">

        <div id="tipContent"></div>

        <div id="tipDots"></div>

        <div class="tip-nav">
            <button id="prevTip">←</button>
            <button id="nextTip">→</button>
        </div>

        <div class="tip-actions">
            <button id="closeTip">Close</button>
            <button id="disableTips">Don't show</button>
        </div>

    </div>

    <!-- TIP SCRIPT -->
    <script type="module">
        import { initTips } from "/js/tips.js";

        initTips({
            tips: [
                "<strong>Welcome to Scriptorium </strong><br><br>Your personal space to explore, organize, and enjoy books, music, movies all in one place. ",
                "<strong>Navigate Your World</strong><br><br>Move between Library, Music, and Theatre to study, relax, or watch.<br>Each room is built for a different experience.",
                "<strong>Interact & Discover</strong><br><br>Click objects to unlock, explore content, and personalize your journey."
            ]
        });
    </script>

    <!-- 3D ROOM -->
    <script type="module" src="/js/main-room-3d.js"></script>

</body>
</html>