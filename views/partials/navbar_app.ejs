                            <form action="/logout" method="POST" class="block w-full">
                                <button type="submit" class="w-full text-left px-5 py-3 text-[#FF6B6B] hover:text-[#ff8585] font-outfit text-base font-medium hover:bg-white/5 transition-colors">
                                    Logout
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </nav>


       <script src="/js/navbar.js"></script>

        <style>
            @keyframes fadeInDown {
                from { opacity: 0; transform: translateY(-10px); }
