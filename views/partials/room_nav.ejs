<div class="fixed right-4 top-1/2 -translate-y-1/2 z-[90] flex flex-col gap-4">
  <% const isRoom = typeof currentPage !== 'undefined' && currentPage === 'room'; %>
  <% if (typeof currentPage === 'undefined' || currentPage !== 'music') { %>
  <a href="/music" class="group flex flex-col items-center gap-1 hover:scale-110 transition-transform duration-200 <%= isRoom ? 'bg-black/50 backdrop-blur-md border border-white/20 rounded-2xl px-3 py-2' : '' %>">
    <span class="text-2xl drop-shadow-lg">🎵</span>
    <span class="text-[10px] font-medium transition-colors duration-200 tracking-wide <%= isRoom ? 'text-white/80 group-hover:text-[#FFDA6D]' : 'text-white/50 group-hover:text-[#FFDA6D]' %>">Music</span>
  </a>
  <% } %>
  <% if (typeof currentPage === 'undefined' || currentPage !== 'library') { %>
  <a href="/library" class="group flex flex-col items-center gap-1 hover:scale-110 transition-transform duration-200 <%= isRoom ? 'bg-black/50 backdrop-blur-md border border-white/20 rounded-2xl px-3 py-2' : '' %>">
    <span class="text-2xl drop-shadow-lg">📚</span>
    <span class="text-[10px] font-medium transition-colors duration-200 tracking-wide <%= isRoom ? 'text-white/80 group-hover:text-[#FFDA6D]' : 'text-white/50 group-hover:text-[#FFDA6D]' %>">Library</span>
  </a>
  <% } %>
  <% if (typeof currentPage === 'undefined' || currentPage !== 'theatre') { %>
  <a href="/theatre" class="group flex flex-col items-center gap-1 hover:scale-110 transition-transform duration-200 <%= isRoom ? 'bg-black/50 backdrop-blur-md border border-white/20 rounded-2xl px-3 py-2' : '' %>">
    <span class="text-2xl drop-shadow-lg">🎬</span>
    <span class="text-[10px] font-medium transition-colors duration-200 tracking-wide <%= isRoom ? 'text-white/80 group-hover:text-[#FFDA6D]' : 'text-white/50 group-hover:text-[#FFDA6D]' %>">Theatre</span>
  </a>
  <% } %>
  <div class="flex flex-col items-center"><%- include('./ai_button') %></div>
</div>